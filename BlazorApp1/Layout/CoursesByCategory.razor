@page "/courses-by-category/{CategoryId:int}"
@inject HttpClient Http
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime


<link href="css/CoursesByCategory.css" rel="stylesheet" />
<div class="category-page">
    <div class="category-header">
        <div class="header-content">
            <h1>@CategoryName</h1>
            <p>Курсы для профессионального роста в выбранной области</p>
        </div>
        <div class="header-overlay"></div>
        <div class="header-shapes">
            <div class="shape circle"></div>
            <div class="shape triangle"></div>
            <div class="shape wave"></div>
        </div>
    </div>

    <div class="container">
        <div class="courses-section">
            @if (isLoading)
            {
                <div class="loading-courses">
                    <div class="spinner">
                        <div class="double-bounce1"></div>
                        <div class="double-bounce2"></div>
                    </div>
                    <p>Загружаем лучшие курсы для вас...</p>
                </div>
            }
            else if (courses != null && !courses.Any())
            {
                <div class="no-courses">
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="fas fa-book-open"></i>
                        </div>
                        <h3>В этой категории пока нет курсов</h3>
                        <p>Но мы работаем над добавлением новых материалов. Посмотрите другие категории</p>
                        <button class="btn btn-primary" @onclick="NavigateToAllCourses">
                            <i class="fas fa-compass"></i> Посмотреть все курсы
                        </button>
                    </div>
                </div>
            }
            else if (courses != null)
            {
                <div class="courses-grid">
                    @foreach (var course in courses)
                    {
                        <div class="course-card">
                            <div class="card-top">
                                <div class="course-image">
                                    <img src="@course.ImageUrl"
                                         onerror="this.onerror=null; this.src='/images/courses/default-course.png'"
                                         alt="@course.Title" />
                                    @if (course.IsNew)
                                    {
                                        <div class="course-badge new">NEW</div>
                                    }
                                    @if (course.IsPopular)
                                    {
                                        <div class="course-badge popular">HOT</div>
                                    }
                                </div>
                                <div class="course-price">
                                    @if (course.DiscountedPrice > 0)
                                    {
                                        <span class="original-price">@course.Price.ToString("N0") ₽</span>
                                        <span class="discounted-price">@course.DiscountedPrice.ToString("N0") ₽</span>
                                    }
                                    else
                                    {
                                        <span>@course.Price.ToString("N0") ₽</span>
                                    }
                                </div>
                            </div>

                            <div class="course-info">
                                <h3>@course.Title</h3>
                                <p>@course.Description</p>

                                <div class="course-footer">
                                    <div class="course-duration">
                                        <i class="fas fa-clock"></i> @course.Duration недель
                                    </div>
                                    <div class="course-category">
                                        <i class="fas fa-tag"></i> @course.Category
                                    </div>
                                </div>
                            </div>

                            <div class="course-actions">
                                <button class="btn-details" @onclick="() => ViewCourseDetails(course.Id)">
                                    <i class="fas fa-info-circle"></i> Подробнее
                                </button>
                                <button class="btn-buy" @onclick="() => AddToCart(course)">
                                    <i class="fas fa-shopping-cart"></i> Купить
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int CategoryId { get; set; }
    private string CategoryName { get; set; } = "Категория";
    private List<CourseDto> courses = new List<CourseDto>();
    private bool isLoading = true;

    // Карта изображений для категорий
    private static readonly Dictionary<string, string> categoryImages = new(StringComparer.OrdinalIgnoreCase)
        {
            ["бизнес"] = "course-business.png",
            ["языки"] = "course-language.png",
            ["дизайн"] = "course-design.png",
            ["разработка"] = "course-dev.png",
            ["маркетинг"] = "course-marketing.png",
            ["наука"] = "course-science.png",
        };

    protected override async Task OnInitializedAsync()
    {
        await LoadCategoryName();
        await LoadCourses();
    }

    private void NavigateToAllCourses()
    {
        NavManager.NavigateTo("/courses");
    }

    private async Task LoadCategoryName()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<CourseCategory>($"api/Categories/{CategoryId}");
            if (response != null)
            {
                CategoryName = response.name;
            }
        }
        catch
        {
            CategoryName = "Категория";
        }
    }

    private async Task LoadCourses()
    {
        try
        {
            isLoading = true;
            StateHasChanged(); // Обновляем UI

            var courseIds = await Http.GetFromJsonAsync<List<int>>(
                $"api/Courses/category-course-ids/{CategoryId}") ?? new List<int>();

            if (courseIds.Count == 0)
            {
                courses = new List<CourseDto>();
                return;
            }

            courses = await Http.GetFromJsonAsync<List<CourseDto>>(
                $"api/Courses/by-ids?ids={string.Join(",", courseIds)}") ?? new List<CourseDto>();

            foreach (var course in courses)
            {
                course.ImageUrl = GetCourseImage(course.Category);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки курсов: {ex.Message}");
            courses = new List<CourseDto>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged(); // Обновляем UI после загрузки
        }
    }

    private string GetCourseImage(string category)
    {
        if (string.IsNullOrWhiteSpace(category))
            return "/images/courses/default-course.png";

        var normalizedCategory = category.Trim().ToLower();

        if (categoryImages.TryGetValue(normalizedCategory, out var imageName))
        {
            return $"/images/courses/{imageName}";
        }

        var partialMatch = categoryImages.Keys.FirstOrDefault(k =>
            normalizedCategory.Contains(k));

        return partialMatch != null
            ? $"/images/courses/{categoryImages[partialMatch]}"
            : "/images/courses/default-course.png";
    }

    private void ViewCourseDetails(int courseId)
    {
        NavManager.NavigateTo($"/course/{courseId}");
    }

    private void AddToCart(CourseDto course)
    {
        JSRuntime.InvokeVoidAsync("showToast",
            $"Курс \"{course.Title}\" добавлен в корзину!");
    }

    public class CourseCategory
    {
        public int Id { get; set; }
        public string name { get; set; } = string.Empty;
    }

    public class CourseDto
    {
        public int Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public decimal Price { get; set; }
        public decimal DiscountedPrice { get; set; }
        public double Rating { get; set; }
        public int EnrolledCount { get; set; }
        public int Duration { get; set; }
        public bool IsNew { get; set; }
        public bool IsPopular { get; set; }
        public string ImageUrl { get; set; } = string.Empty;
    }
}

