<script>
    window.getCookie = function(name) {
        const value = `; ${document.cookie}`;
        const parts = value.split(`; ${name}=`);
        if (parts.length === 2) return parts.pop().split(';').shift();
    };
</script>


@code {
    private bool showMobileMenu = false;
    private bool showProfileMenu = false;

    private string fullName = "";
    private string email = "";
    private string avatarUrl = "";
    private string avatarColor = "#3498db"; // Значение по умолчанию
    private bool isLoaded = false; // Флаг загрузки данных
    @implements IDisposable

    @inject AuthenticationStateProvider AuthStateProvider

    protected override async Task OnInitializedAsync()
    {
        // Подписываемся на изменения состояния аутентификации
        (AuthStateProvider as AuthenticationStateProvider)!.AuthenticationStateChanged += AuthStateChanged;
        await LoadUserData();
    }

    private async void AuthStateChanged(Task<AuthenticationState> task)
    {
        await LoadUserData();
        StateHasChanged();
    }

    public void Dispose()
    {
        // Отписываемся от событий при уничтожении компонента
        (AuthStateProvider as AuthenticationStateProvider)!.AuthenticationStateChanged -= AuthStateChanged;
    }

    private string GetInitials(string fullName)
    {
        if (string.IsNullOrEmpty(fullName)) return "??";

        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "??";

        string first = parts[0][0].ToString();
        string last = parts.Length > 1 ? parts[^1][0].ToString() : "";

        return $"{first}{last}".ToUpper();
    }
    private string GetAvatarUrl(ClaimsPrincipal user)
    {
        return user?.FindFirst("AvatarUrl")?.Value ?? "";
    }
    private bool _isLoadingData = false; // Добавьте флаг загрузки

    private async Task LoadUserData()
    {
        if (_isLoadingData) return;

        try
        {
            _isLoadingData = true;
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                // УБРАТЬ ВЫЗОВ RefreshAuthenticationState
                // var authProvider = (CustomAuthStateProvider)AuthStateProvider;
                // await authProvider.RefreshAuthenticationState();

                fullName = user.Identity.Name ?? "";
                email = user.FindFirst(ClaimTypes.Email)?.Value ?? "";
                avatarUrl = user.FindFirst("AvatarUrl")?.Value ?? "";
                avatarColor = user.FindFirst("AvatarColor")?.Value ?? "#3498db";
            }

            isLoaded = true;
            // StateHasChanged(); // Убрать - вызовется автоматически
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user data: {ex.Message}");
        }
        finally
        {
            _isLoadingData = false;
        }
    }
    private string GetAvatarColor(ClaimsPrincipal user)
    {
        return user?.FindFirst("AvatarColor")?.Value ?? "#3498db";
    }
    private void ToggleMobileMenu()
    {
        showMobileMenu = !showMobileMenu;
        showProfileMenu = false;
    }

    private void ToggleProfileMenu()
    {
        showProfileMenu = !showProfileMenu;
    }

    private void NavigateToProfile()
    {
        NavManager.NavigateTo("/profile");
        CloseMenus();
    }
    private string GetAvatarUrlWithCacheBuster(string avatarUrl)
    {
        if (string.IsNullOrEmpty(avatarUrl))
            return string.Empty;

        return $"{avatarUrl}?v={DateTime.Now.Ticks}";
    }
    private void NavigateToAvatarSettings()
    {
        NavManager.NavigateTo("/profile/avatar");
        CloseMenus();
    }

    private string GetShortName(string fullName)
    {
        if (string.IsNullOrEmpty(fullName))
            return "Гость";

        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 0 ? parts[0] : "Гость";
    }
    private void NavigateToGoals()
    {
        NavManager.NavigateTo("/profile/goals");
        CloseMenus();
    }

    private void NavigateToLogin()
    {
        NavManager.NavigateTo("/login");
        CloseMenus();
    }

    private void NavigateToRegister()
    {
        NavManager.NavigateTo("/register");
        CloseMenus();
    }

    private void CloseMenus()
    {
        showProfileMenu = false;
        showMobileMenu = false;
    }

    private async Task Logout()
    {
        try
        {
            // Отправляем запрос на выход на сервер
            var response = await Http.PostAsync("api/User/logout", null);

            if (response.IsSuccessStatusCode)
            {
                // Очищаем клиентское состояние
                var authProvider = (CustomAuthStateProvider)AuthStateProvider;
                await authProvider.ClearUserAsync();

                // Перенаправляем на страницу входа
                NavManager.NavigateTo("/login");
            }
            else
            {
                Console.WriteLine($"Ошибка выхода: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при выходе: {ex.Message}");
        }
        finally
        {
            CloseMenus();
        }
    }
    }
}