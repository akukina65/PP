@code {
    private bool showMobileMenu = false;
    private bool showProfileMenu = false;

    private string fullName = "";
    private string email = "";
    private string avatarUrl = "";
    private bool isLoaded = false; // Флаг загрузки данных

    protected override async Task OnInitializedAsync()
    {
        // Загружаем состояние аутентификации
        await AuthStateProvider.GetAuthenticationStateAsync();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            fullName = user.Identity.Name ?? "";
            email = user.FindFirst(ClaimTypes.Email)?.Value ?? "";
            avatarUrl = user.FindFirst("AvatarUrl")?.Value ?? "";
        }

        isLoaded = true; // Помечаем данные как загруженные
        StateHasChanged(); // Принудительно обновляем UI
    }

    private string GetInitials(string fullName)
    {
        if (string.IsNullOrEmpty(fullName)) return "??";

        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "??";

        string first = parts[0][0].ToString();
        string last = parts.Length > 1 ? parts[^1][0].ToString() : "";

        return $"{first}{last}".ToUpper();
    }

    private void ToggleMobileMenu()
    {
        showMobileMenu = !showMobileMenu;
        showProfileMenu = false;
    }

    private void ToggleProfileMenu()
    {
        showProfileMenu = !showProfileMenu;
    }

    private void NavigateToProfile()
    {
        NavManager.NavigateTo("/profile");
        CloseMenus();
    }

    private void NavigateToAvatarSettings()
    {
        NavManager.NavigateTo("/profile/avatar");
        CloseMenus();
    }
    private string GetShortName(string fullName)
    {
        if (string.IsNullOrEmpty(fullName))
            return "Гость";

        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        // Если есть и имя, и фамилия - показываем только имя
        if (parts.Length >= 2)
            return parts[0];

        // Если только одно слово - показываем его полностью
        return parts.Length > 0 ? parts[0] : "Гость";
    }
    private void NavigateToGoals()
    {
        NavManager.NavigateTo("/profile/goals");
        CloseMenus();
    }

    private void NavigateToLogin()
    {
        NavManager.NavigateTo("/login");
        CloseMenus();
    }

    private void NavigateToRegister()
    {
        NavManager.NavigateTo("/register");
        CloseMenus();
    }

    private void CloseMenus()
    {
        showProfileMenu = false;
        showMobileMenu = false;
    }

    private async Task Logout()
    {
        await Http.PostAsync("http://localhost:5199/api/User/logout", null);

        var authProvider = (CustomAuthStateProvider)AuthStateProvider;
        await authProvider.ClearUserAsync();

        CloseMenus();
        NavManager.NavigateTo("/login", forceLoad: true);
    }
}