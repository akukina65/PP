@page "/"
@page "/glav"
@layout NoLayout
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider
@using System.Security.Claims;
@inject IJSRuntime JSRuntime
<link href="css/glav.css?v=3.0" rel="stylesheet" />
<CascadingAuthenticationState>
    <AuthorizeView>
        <Authorized>
            <header class="header">
                <div class="container">
                    <div class="logo">
                        <img src="/images/image1.png" alt="Логотип платформы" />
                    </div>

                    <nav class="nav">
                        <NavLink href="/glav" class="nav-link active">Главная</NavLink>
                        <NavLink href="/courses" class="nav-link">Курсы</NavLink>
                        <NavLink href="/shop" class="nav-link">Магазин</NavLink>
                        <NavLink href="/cart" class="nav-link">Корзина</NavLink>
                    </nav>

                    <div class="user-profile" @onclick="ToggleProfileMenu">
                        @{
                            var avatarUrl = context.User.FindFirst("AvatarUrl")?.Value;
                            var avatarColor = context.User.FindFirst("AvatarColor")?.Value ?? "#3498db";
                        }
                        <div class="avatar-placeholder" style="background: @avatarColor">
                            @if (!string.IsNullOrEmpty(avatarUrl))
                            {
                                <!-- Добавляем префикс пути -->
                                <img src="/images/avatars/@GetAvatarUrlWithCacheBuster(avatarUrl)"
                                     alt="Аватар"
                                     class="avatar-small"
                                     onerror="this.onerror=null;this.src='/images/default-avatar.png';" />
                            }
                            else
                            {
                                @GetInitials(context.User.Identity.Name)
                            }
                        </div>
                        <span class="user-name">
                            @GetShortName(context.User.Identity.Name)
                        </span>

                        @if (showProfileMenu)
                        {
                            <div class="profile-menu">
                                <div class="profile-header">
                                    @{
                                        var fullName = context.User.Identity.Name;
                                        var email = context.User.FindFirst(ClaimTypes.Email)?.Value;
                                    }
                                    @if (!string.IsNullOrEmpty(avatarUrl))
                                    {
                                        <img src="@avatarUrl"
                                             alt="@fullName"
                                             class="profile-avatar"
                                             onerror="this.style.display='none'; this.parentElement.querySelector('.avatar-placeholder-large').style.display='flex';" />
                                    }
                                    <div class="avatar-placeholder large"
                                         style="background: @avatarColor; @(!string.IsNullOrEmpty(avatarUrl) ? "display: none" : "")">
                                        @GetInitials(fullName)
                                    </div>
                                    <div class="profile-info">
                                        <div class="user-name">@fullName</div>
                                        <div class="user-email">@email</div>
                                    </div>
                                </div>
                                <div class="menu-items">
                                    <div class="menu-item" @onclick="NavigateToProfile">
                                        <span class="icon">👤</span>
                                        <span>Мой профиль</span>
                                    </div>
                                    <div class="menu-item" @onclick="NavigateToAvatarSettings">
                                        <span class="icon">📷</span>
                                        <span>Настройка аватара</span>
                                    </div>
                                    <div class="menu-item" @onclick="NavigateToGoals">
                                        <span class="icon">🏆</span>
                                        <span>Цели и достижения</span>
                                    </div>
                                    <div class="menu-divider"></div>
                                    <div class="menu-item logout" @onclick="Logout">
                                        <span class="icon">🚪</span>
                                        <span>Выход</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <button class="mobile-menu-btn" @onclick="ToggleMobileMenu">
                        <span class="icon">☰</span>
                    </button>
                </div>

                <!-- Мобильное меню -->
                <div class="mobile-menu @(showMobileMenu ? "show" : "")">
                    <NavLink href="/glav" class="mobile-nav-link active">Главная</NavLink>
                    <NavLink href="/courses" class="mobile-nav-link">Курсы</NavLink>
                    <NavLink href="/shop" class="mobile-nav-link">Магазин</NavLink>
                    <NavLink href="/cart" class="mobile-nav-link">Корзина</NavLink>
                    <div class="mobile-profile-menu">
                        <div class="mobile-user-info">
                            @if (!string.IsNullOrEmpty(avatarUrl))
                            {
                                <img src="@avatarUrl"
                                     alt="Аватар"
                                     class="mobile-avatar"
                                     onerror="this.style.display='none'; this.parentElement.querySelector('.mobile-avatar-placeholder').style.display='flex';" />
                            }
                            <div class="mobile-avatar-placeholder"
                                 style="background: @avatarColor; @(!string.IsNullOrEmpty(avatarUrl) ? "display: none" : "")">
                                @GetInitials(context.User.Identity.Name)
                            </div>
                            <div class="mobile-user-name">@GetShortName(context.User.Identity.Name)</div>
                        </div>
                        <div class="mobile-menu-item" @onclick="NavigateToProfile">Мой профиль</div>
                        <div class="mobile-menu-item" @onclick="NavigateToAvatarSettings">Настройка аватара</div>
                        <div class="mobile-menu-item" @onclick="NavigateToGoals">Цели и достижения</div>
                        <div class="mobile-menu-divider"></div>
                        <div class="mobile-menu-item logout" @onclick="Logout">Выход</div>
                    </div>
                </div>
            </header>
        </Authorized>
        <NotAuthorized>
            <header class="header">
                <div class="container">
                    <div class="logo">
                        <img src="/images/image1.png" alt="Логотип платформы" />
                    </div>

                    <nav class="nav">
                        <NavLink href="/glav" class="nav-link active">Главная</NavLink>
                        <NavLink href="/courses" class="nav-link">Курсы</NavLink>
                        <NavLink href="/shop" class="nav-link">Магазин</NavLink>
                        <NavLink href="/cart" class="nav-link">Корзина</NavLink>
                    </nav>

                    <div class="auth-buttons">
                        <button class="btn btn-outline" @onclick="NavigateToLogin">Вход</button>
                        <button class="btn btn-primary" @onclick="NavigateToRegister">Регистрация</button>
                    </div>

                    <button class="mobile-menu-btn" @onclick="ToggleMobileMenu">
                        <span class="icon">☰</span>
                    </button>
                </div>

                <!-- Мобильное меню -->
                <div class="mobile-menu @(showMobileMenu ? "show" : "")">
                    <NavLink href="/glav" class="mobile-nav-link active">Главная</NavLink>
                    <NavLink href="/courses" class="mobile-nav-link">Курсы</NavLink>
                    <NavLink href="/shop" class="mobile-nav-link">Магазин</NavLink>
                    <NavLink href="/cart" class="mobile-nav-link">Корзина</NavLink>
                    <div class="mobile-auth-buttons">
                        <button class="btn btn-outline" @onclick="NavigateToLogin">Вход</button>
                        <button class="btn btn-primary" @onclick="NavigateToRegister">Регистрация</button>
                    </div>
                </div>
            </header>
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>

