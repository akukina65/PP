@page "/profile/avatar"
@layout MainLayout
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject HttpClient Http
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime


<link href="css/Avatar.css?v=3.0" rel="stylesheet" />
<CascadingAuthenticationState>
    <AuthorizeView>
        <Authorized>
            <div class="avatar-settings-container">
                <div class="header-section">
                    <h1><i class="fas fa-user-circle"></i> Настройка аватара</h1>
                    <div class="back-link" @onclick="NavigateToProfile">
                        <i class="fas fa-arrow-left"></i> Назад к профилю
                    </div>
                </div>

                @if (showNotification)
                {
                    <div class="notification @(isSuccess ? "success" : "error")">
                        <i class="fas @(isSuccess ? "fa-check-circle" : "fa-exclamation-circle")"></i>
                        @notificationMessage
                    </div>
                }

                <div class="avatar-content">
                    <!-- Объединенная секция предпросмотра -->
                    <div class="avatar-preview-section">
                        <h3>Предпросмотр нового аватара</h3>
                        <div class="preview-container">
                            <div class="preview-avatar">
                                @if (!string.IsNullOrEmpty(selectedAvatar))
                                {
                                    <img src="@GetAvatarUrlWithCacheBuster(selectedAvatar)"
                                         alt="Выбранный аватар"
                                         class="preview-image"
                                         onerror="this.onerror=null;this.src='/images/default-avatar.png';" />
                                }
                                else
                                {
                                    <div class="preview-placeholder" style="background: @selectedColor">
                                        @GetInitials(fullName)
                                    </div>
                                }
                            </div>
                            <div class="preview-info">
                                <div class="preview-title">Ваш аватар будет выглядеть так:</div>
                                <div class="preview-hint">
                                    @if (!string.IsNullOrEmpty(selectedAvatar))
                                    {
                                        <span>Вы выбрали изображение</span>
                                    }
                                    else
                                    {
                                        <span>Цвет фона: <span class="color-badge" style="background: @selectedColor"></span></span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="avatar-options-section">
                        <div class="options-header">
                            <h3>Выберите новый аватар</h3>
                            <div class="options-toggle">
                                <button class="toggle-btn @(showAvatars ? "active" : "")"
                                        @onclick="() => ToggleOptions(true)">
                                    Изображения
                                </button>
                                <button class="toggle-btn @(!showAvatars ? "active" : "")"
                                        @onclick="() => ToggleOptions(false)">
                                    Цвета
                                </button>
                            </div>
                        </div>

                        @if (showAvatars)
                        {
                            <!-- Список аватаров -->
                            <div class="avatar-grid">
                                @foreach (var avatar in availableAvatars)
                                {
                                    <div class="avatar-option @(selectedAvatar == avatar ? "selected" : "")"
                                         @onclick="() => SelectAvatar(avatar)"
                                         title="Аватар @avatar.Replace(".png", "")">
                                        <!-- Исправленный путь + обработка ошибок -->
                                        <img src="@GetAvatarUrlWithCacheBuster(avatar)"
                                             alt="Аватар @avatar"
                                             onerror="this.onerror=null;this.src='/images/default-avatar.png';" />
                                        @if (selectedAvatar == avatar)
                                        {
                                            <div class="selected-badge">
                                                <i class="fas fa-check"></i>
                                            </div>
                                        }
                                    </div>
                                }

                                <div class="avatar-option @(string.IsNullOrEmpty(selectedAvatar) ? "selected" : "")"
                                     @onclick="RemoveAvatar"
                                     title="Без аватара">
                                    <div class="avatar-placeholder" style="background: @selectedColor">
                                        @GetInitials(fullName)
                                    </div>
                                    <div class="avatar-label">Без аватара</div>
                                    @if (string.IsNullOrEmpty(selectedAvatar))
                                    {
                                        <div class="selected-badge">
                                            <i class="fas fa-check"></i>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- Палитра цветов -->
                            <div class="color-picker-section">
                                <h4>Выберите цвет фона</h4>
                                <div class="color-palette">
                                    @foreach (var color in availableColors)
                                    {
                                        <div class="color-option @(color == selectedColor ? "selected" : "")"
                                             style="background: @color"
                                             @onclick="() => SelectColor(color)"
                                             title="@color">
                                            @if (color == selectedColor)
                                            {
                                                <i class="fas fa-check"></i>
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="custom-color">
                                    <label>Или введите свой цвет:</label>
                                    <div class="color-input">
                                        <input type="color"
                                               value="@customColor"
                                               @onchange="HandleColorChange" />
                                        <input type="text"
                                               value="@customColor"
                                               @oninput="HandleTextInput"
                                               placeholder="#HEX код" />
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="avatar-actions">
                            <button class="btn-save" @onclick="SaveAvatar">
                                <i class="fas fa-save"></i> Сохранить изменения
                            </button>
                            <button class="btn-cancel" @onclick="NavigateToProfile">
                                <i class="fas fa-times"></i> Отмена
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>
</CascadingAuthenticationState>


@code {
    private string fullName = "";
    private string email = "";
    private string currentAvatar = "";
    private string selectedAvatar = "";
    private string selectedColor = "#3498db";
    private string customColor = "#3498db";
    private bool showAvatars = true;
    private string notificationMessage = "";
    private bool showNotification = false;
    private bool isSuccess = true;
    private Random random = new Random();

    // Список доступных аватаров
    private List<string> availableAvatars = new List<string>
    {
        "avatar1.png", "avatar2.png", "avatar3.png",
        "avatar4.png", "avatar5.png", "avatar6.png"
    };

    // Список доступных цветов
    private List<string> availableColors = new List<string>
    {
        "#FF6B6B", "#4ECDC4", "#45B7D1", "#FFA07A", "#98D8C8",
        "#F78FB3", "#7BC8A4", "#FF9A76", "#6A89CC", "#F8C291",
        "#3498db", "#2ecc71", "#e74c3c", "#f1c40f", "#9b59b6"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadUserData();

    }

    private string GetAvatarUrlWithCacheBuster(string avatar)
    {
        // Добавляем параметр для предотвращения кэширования
        return $"/images/avatars/{avatar}?v={random.Next(1, 100000)}";
    }

    private async Task LoadUserData()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            fullName = user.Identity.Name ?? "";
            email = user.FindFirst(ClaimTypes.Email)?.Value ?? "";
            currentAvatar = user.FindFirst("AvatarUrl")?.Value ?? "";
            selectedAvatar = currentAvatar;

            // Загружаем сохраненный цвет
            var colorClaim = user.FindFirst("AvatarColor");
            if (colorClaim != null && !string.IsNullOrEmpty(colorClaim.Value))
            {
                selectedColor = colorClaim.Value;
                customColor = colorClaim.Value;
            }
        }
    }

    private void ToggleOptions(bool showAvatarOptions)
    {
        showAvatars = showAvatarOptions;
        // При переключении на цвета - выбираем вариант без аватара
        if (!showAvatarOptions)
        {
            selectedAvatar = "";
        }
    }

    private void SelectAvatar(string avatar)
    {
        selectedAvatar = avatar;
    }

    private void RemoveAvatar()
    {
        selectedAvatar = "";
        showAvatars = false; // Автоматически показываем цвета
    }

    private void SelectColor(string color)
    {
        selectedColor = color;
        customColor = color;
    }

    // Обработчики для полей ввода цвета
    private void HandleColorChange(ChangeEventArgs e)
    {
        customColor = e.Value?.ToString() ?? "#3498db";
        SetCustomColor();
    }

    private void HandleTextInput(ChangeEventArgs e)
    {
        customColor = e.Value?.ToString() ?? "#3498db";
        SetCustomColor();
    }

    private void SetCustomColor()
    {
        // Проверяем валидность цвета
        if (System.Text.RegularExpressions.Regex.IsMatch(
            customColor, "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$"))
        {
            selectedColor = customColor;
        }
    }

    private async Task SaveAvatar()
    {
        try
        {
            var response = await Http.PostAsJsonAsync("api/User/update-avatar", new
            {
                AvatarUrl = selectedAvatar,
                AvatarColor = selectedColor
            });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<UpdateAvatarResult>();
                if (result != null)
                {
                    var authProvider = (CustomAuthStateProvider)AuthStateProvider;
                    await authProvider.UpdateAvatarAsync(result.avatarUrl, selectedColor);

                    // Принудительное обновление всех компонентов
                    authProvider.NotifyUserChanged();

                    currentAvatar = result.avatarUrl;
                    ShowNotification("Аватар успешно обновлен!", true);
                }
            }
        }
        catch (Exception ex)
        {
            ShowNotification($"Ошибка: {ex.Message}", false);
        }
    }
    private class UpdateAvatarResult
    {
        public string message { get; set; }
        public string avatarUrl { get; set; }
        public string avatarColor { get; set; }
    }

    private string GetInitials(string fullName)
    {
        if (string.IsNullOrEmpty(fullName)) return "??";

        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "??";

        string first = parts[0][0].ToString();
        string last = parts.Length > 1 ? parts[^1][0].ToString() : "";

        return $"{first}{last}".ToUpper();
    }

    private void ShowNotification(string message, bool success)
    {
        notificationMessage = message;
        isSuccess = success;
        showNotification = true;

        Task.Delay(3000).ContinueWith(_ =>
        {
            showNotification = false;
            InvokeAsync(StateHasChanged);
        });
    }

    private void NavigateToProfile()
    {
        NavManager.NavigateTo("/profile");
    }
}