@page "/profile"
@layout MainLayout
@using Microsoft.AspNetCore.Components.Authorization
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject HttpClient Http
@inject NavigationManager NavManager
@using YourProjectNamespace.Models
<CascadingAuthenticationState>
    <AuthorizeView>
        <Authorized>
            <div class="profile-container">
                <!-- Заголовок с градиентом -->
                <div class="profile-header bg-gradient">
                    <h1><i class="fas fa-user-cog"></i> Настройки автора</h1>
                    <div class="back-link" @onclick="NavigateToHome">
                        <i class="fas fa-arrow-left"></i> На главную
                    </div>
                </div>

                <!-- Уведомление -->
                @if (showNotification)
                {
                    <div class="notification @(isSuccess ? "success" : "error") animate__animated animate__fadeInDown">
                        <i class="fas @(isSuccess ? "fa-check-circle" : "fa-exclamation-circle")"></i>
                        @notificationMessage
                    </div>
                }

                <!-- Основной контент -->
                <div class="profile-content">
                    <!-- Левая колонка - информация о пользователе -->
                    <div class="user-info-section">
                        <!-- Карточка пользователя с тенью -->
                        <div class="user-card shadow">
                            <div class="user-avatar">
                                @if (!string.IsNullOrEmpty(avatarUrl))
                                {
                                    <img src="/images/@avatarUrl" alt="@fullName" class="avatar-img" />
                                }
                                else
                                {
                                    <div class="avatar-placeholder gradient-bg">
                                        @GetInitials(fullName)
                                    </div>
                                }
                                <div class="avatar-overlay">
                                    <i class="fas fa-camera"></i>
                                </div>
                            </div>
                            <div class="user-details">
                                <h2>@($"{profileModel.LastName} {profileModel.FirstName} {profileModel.Patronymic}".Trim())</h2>
                                <div class="user-meta">
                                    <!-- Убрано поле "Курс" -->
                                    <div class="meta-item">
                                        <i class="fas fa-city"></i>
                                        <span>Город: <strong>@(city ?? "Не указан")</strong></span>
                                    </div>
                                    <div class="meta-item">
                                        <i class="fas fa-envelope"></i>
                                        <span>Электронная почта: <strong>@email</strong></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Настройки автора -->
                        <div class="author-settings card shadow">
                            <h3><i class="fas fa-cog"></i> Настройки автора</h3>
                            <div class="settings-actions">
                                <button class="btn-settings" @onclick="NavigateToCourses">
                                    <i class="fas fa-book"></i> Мои курсы
                                </button>
                                <button class="btn-settings" @onclick="NavigateToMaterials">
                                    <i class="fas fa-file-alt"></i> Учебные материалы
                                </button>
                                <button class="btn-settings" @onclick="NavigateToStats">
                                    <i class="fas fa-chart-bar"></i> Статистика
                                </button>
                                <button class="btn-settings" @onclick="NavigateToPayments">
                                    <i class="fas fa-credit-card"></i> Платежи
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Правая колонка - форма редактирования -->
                    <div class="edit-form-section card shadow">
                        <h3><i class="fas fa-edit"></i> Редактировать профиль</h3>

                        <EditForm Model="@profileModel" OnValidSubmit="@SaveProfile">
                            <ChildContent Context="formContext">
                                <DataAnnotationsValidator />

                                <div class="form-row">
                                    <div class="form-group floating">
                                        <InputText @bind-Value="profileModel.FirstName" class="form-control" placeholder=" " />
                                        <label>Имя</label>
                                        <ValidationMessage For="@(() => profileModel.FirstName)" />
                                    </div>

                                    <div class="form-group floating">
                                        <InputText @bind-Value="profileModel.LastName" class="form-control" placeholder=" " />
                                        <label>Фамилия</label>
                                        <ValidationMessage For="@(() => profileModel.LastName)" />
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group floating">
                                        <InputText @bind-Value="profileModel.Patronymic" class="form-control" placeholder=" " />
                                        <label>Отчество</label>
                                        <ValidationMessage For="@(() => profileModel.Patronymic)" />
                                    </div>
                                </div>
                                <!-- Убрано поле "Курс" -->
                                <div class="form-row">
                                    <div class="form-group floating">
                                        <InputText @bind-Value="profileModel.City" class="form-control" placeholder=" " />
                                        <label>Город</label>
                                        <ValidationMessage For="@(() => profileModel.City)" />
                                    </div>
                                </div>

                                <div class="form-group floating">
                                    <InputText @bind-Value="profileModel.Email" class="form-control" placeholder=" " />
                                    <label>Электронная почта</label>
                                    <ValidationMessage For="@(() => profileModel.Email)" />
                                </div>

                                <div class="form-group">
                                    <label><i class="fas fa-info-circle"></i> О себе</label>
                                    <InputTextArea @bind-Value="profileModel.Bio" class="form-control" rows="4" />
                                    <ValidationMessage For="@(() => profileModel.Bio)" />
                                </div>

                                <div class="form-actions">
                                    <button type="submit" class="btn-primary">
                                        <i class="fas fa-save"></i> Сохранить изменения
                                    </button>
                                    <button type="button" class="btn-outline" @onclick="CancelEditing">
                                        <i class="fas fa-times"></i> Отмена
                                    </button>
                                </div>
                            </ChildContent>
                        </EditForm>
                    </div>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>
</CascadingAuthenticationState>

<style>
    :root {
        --primary: #4361ee;
        --secondary: #3f37c9;
        --success: #4cc9f0;
        --light: #f8f9fa;
        --dark: #212529;
        --gray: #6c757d;
        --shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        --transition: all 0.3s ease;
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .profile-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 20px;
    }

    .profile-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 30px;
        border-radius: 12px;
        margin-bottom: 30px;
        color: white;
        box-shadow: var(--shadow);
        background: linear-gradient(135deg, var(--primary), var(--secondary));
    }

        .profile-header h1 {
            font-weight: 600;
            font-size: 1.8rem;
            display: flex;
            align-items: center;
            gap: 12px;
        }

    .back-link {
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        font-weight: 500;
        padding: 8px 16px;
        border-radius: 6px;
        background: rgba(255, 255, 255, 0.15);
        transition: var(--transition);
    }

        .back-link:hover {
            background: rgba(255, 255, 255, 0.25);
            transform: translateX(-3px);
        }

    .profile-content {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 25px;
    }

    .user-info-section {
        display: flex;
        flex-direction: column;
        gap: 25px;
    }

    .user-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        transition: var(--transition);
    }

        .user-card:hover {
            transform: translateY(-5px);
        }

    .user-avatar {
        position: relative;
        height: 180px;
        display: flex;
        justify-content: center;
        align-items: center;
        background: linear-gradient(45deg, #f5f7fa, #c3cfe2);
    }

    .avatar-img {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid white;
        box-shadow: var(--shadow);
    }

    .avatar-placeholder {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        font-weight: bold;
        color: white;
        background: linear-gradient(135deg, #6a11cb, #2575fc);
    }

    .avatar-overlay {
        position: absolute;
        bottom: 20px;
        right: 40%;
        background: var(--primary);
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        cursor: pointer;
        opacity: 0;
        transform: translateY(10px);
        transition: var(--transition);
    }

    .user-avatar:hover .avatar-overlay {
        opacity: 1;
        transform: translateY(0);
    }

    .user-details {
        padding: 25px;
    }

        .user-details h2 {
            font-size: 1.5rem;
            margin-bottom: 15px;
            color: var(--dark);
            text-align: center;
        }

    .user-meta {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.95rem;
        color: var(--gray);
    }

        .meta-item i {
            width: 24px;
            color: var(--primary);
        }

    .author-settings {
        background: white;
        border-radius: 12px;
        padding: 25px;
        transition: var(--transition);
    }

        .author-settings:hover {
            transform: translateY(-3px);
        }

        .author-settings h3 {
            font-size: 1.3rem;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--dark);
        }

    .settings-actions {
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
    }

    .btn-settings {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 20px;
        background: white;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        font-weight: 500;
        color: var(--dark);
        transition: var(--transition);
        text-align: left;
    }

        .btn-settings:hover {
            background: #f0f5ff;
            border-color: var(--primary);
            color: var(--primary);
            transform: translateX(5px);
        }

        .btn-settings i {
            font-size: 1.2rem;
            width: 24px;
        }

    .edit-form-section {
        background: white;
        border-radius: 12px;
        padding: 30px;
        transition: var(--transition);
    }

        .edit-form-section:hover {
            transform: translateY(-3px);
        }

        .edit-form-section h3 {
            font-size: 1.4rem;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--dark);
        }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }

    .form-group {
        position: relative;
        margin-bottom: 25px;
    }

    .floating {
        position: relative;
    }

        .floating label {
            position: absolute;
            top: 15px;
            left: 15px;
            color: var(--gray);
            pointer-events: none;
            transition: var(--transition);
        }

        .floating .form-control:focus ~ label,
        .floating .form-control:not(:placeholder-shown) ~ label {
            top: -20px;
            left: 5px;
            font-size: 0.8rem;
            color: var(--primary);
            background: white;
            padding: 0 5px;
        }

    .form-control {
        width: 100%;
        padding: 15px;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 1rem;
        transition: var(--transition);
    }

        .form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.15);
            outline: none;
        }

        .form-control[readonly] {
            background-color: #f8f9fa;
        }

    .form-actions {
        display: flex;
        gap: 15px;
        margin-top: 25px;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 8px;
        font-weight: 500;
        cursor: pointer;
        transition: var(--transition);
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 15px rgba(67, 97, 238, 0.3);
        }

    .btn-outline {
        background: white;
        color: var(--primary);
        border: 1px solid var(--primary);
        padding: 12px 25px;
        border-radius: 8px;
        font-weight: 500;
        cursor: pointer;
        transition: var(--transition);
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .btn-outline:hover {
            background: #f0f5ff;
            transform: translateY(-3px);
        }

    .card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        transition: var(--transition);
    }

    .shadow {
        box-shadow: var(--shadow);
    }

    .notification {
        position: fixed;
        top: 30px;
        right: 30px;
        padding: 18px 30px;
        border-radius: 10px;
        color: white;
        z-index: 1000;
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 500;
    }

    .success {
        background: linear-gradient(135deg, #4ade80, #22c55e);
    }

    .error {
        background: linear-gradient(135deg, #f87171, #ef4444);
    }

    @@media (max-width: 992px) {
        .profile-content {
            grid-template-columns: 1fr;
        }

        .form-row {
            grid-template-columns: 1fr;
        }
    }

    /* Анимации */
    .animate__animated {
        animation-duration: 0.5s;
    }

    .gradient-bg {
        background: linear-gradient(135deg, #6a11cb, #2575fc);
    }
</style>

@code {
    private string fullName = "";
    private string email = "";
    private string avatarUrl = "";
    private string? city = null;
    private string? bio = null;
    private string notificationMessage = "";
    private bool showNotification = false;
    private bool isSuccess = true;

    private ProfileModel profileModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadProfileData(); // Загружаем данные профиля
    }

    private async Task LoadProfileData()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            // Получаем данные напрямую из claims
            profileModel = new ProfileModel
                {
                    FirstName = user.FindFirst(ClaimTypes.GivenName)?.Value ?? "",
                    LastName = user.FindFirst(ClaimTypes.Surname)?.Value ?? "",
                    Patronymic = user.FindFirst("Patronymic")?.Value ?? "",
                    Email = user.FindFirst(ClaimTypes.Email)?.Value ?? "",
                    City = user.FindFirst("City")?.Value ?? "",
                    Bio = user.FindFirst("Bio")?.Value ?? "",
                    AvatarUrl = user.FindFirst("AvatarUrl")?.Value ?? ""
                };

            // Обновляем локальные переменные для отображения
            fullName = user.Identity.Name;
            email = profileModel.Email;
            city = profileModel.City;
            bio = profileModel.Bio;
            avatarUrl = profileModel.AvatarUrl;
        }
    }



    private string GetInitials(string fullName)
    {
        if (string.IsNullOrEmpty(fullName)) return "??";

        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "??";

        string first = parts[0][0].ToString();
        string last = parts.Length > 1 ? parts[^1][0].ToString() : "";

        // Добавляем инициал отчества, если есть
        string patronymicInitial = parts.Length > 2 ? parts[1][0].ToString() : "";

        return $"{first}{last}{patronymicInitial}".ToUpper();
    }

    private async Task SaveProfile()
    {
        try
        {
            var response = await Http.PostAsJsonAsync(
                "api/User/update-profile",
                new
                {
                    FirstName = profileModel.FirstName,
                    LastName = profileModel.LastName,
                    Patronymic = profileModel.Patronymic,
                    Email = profileModel.Email,
                    City = profileModel.City,
                    Bio = profileModel.Bio
                });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<UpdateResult>();

                // Обновляем состояние аутентификации ВСЕМИ данными
                var authProvider = (CustomAuthStateProvider)AuthStateProvider;
                await authProvider.UpdateProfileAsync(
                    result.user.email,
                    result.user.name,
                    result.user.surname,
                    result.user.patronymic,
                    result.user.AvatarUrl,
                    result.user.City,
                    result.user.Bio
                );

                // Обновляем локальные переменные
                fullName = $"{result.user.surname} {result.user.name} {result.user.patronymic}".Trim();
                city = result.user.City;
                bio = result.user.Bio;

                ShowNotification("Профиль успешно обновлен", true);
            }
            else
            {
                ShowNotification($"Ошибка: {response.StatusCode}", false);
            }
        }
        catch (Exception ex)
        {
            ShowNotification($"Ошибка: {ex.Message}", false);
        }
    }
    // Обновленный класс для десериализации ответа
    private class UpdateResult
    {
        public string message { get; set; }
        public UserData user { get; set; }

        public class UserData
        {
            public string name { get; set; }
            public string surname { get; set; }
            public string patronymic { get; set; } // Добавлено
            public string email { get; set; }
            public string City { get; set; }
            public string Bio { get; set; }
            public string AvatarUrl { get; set; }
        }
    }

    private void ShowNotification(string message, bool success)
    {
        notificationMessage = message;
        isSuccess = success;
        showNotification = true;

        // Автоматическое скрытие через 3 секунды
        Task.Delay(3000).ContinueWith(_ =>
        {
            showNotification = false;
            InvokeAsync(StateHasChanged);
        });
    }

    private void CancelEditing()
    {
        // Восстанавливаем оригинальные значения
        var nameParts = fullName.Split(' ', 2);
        string firstName = nameParts.Length > 0 ? nameParts[0] : "";
        string lastName = nameParts.Length > 1 ? nameParts[1] : "";

        profileModel = new ProfileModel
            {
                FirstName = firstName,
                LastName = lastName,
                City = city,
                Email = email,
                Bio = bio
            };
    }

    private void NavigateToHome()
    {
        NavManager.NavigateTo("/glav");
    }

    private void NavigateToCourses()
    {
        NavManager.NavigateTo("/profile/courses");
    }

    private void NavigateToMaterials()
    {
        NavManager.NavigateTo("/profile/materials");
    }

    private void NavigateToStats()
    {
        NavManager.NavigateTo("/profile/stats");
    }

    private void NavigateToPayments()
    {
        NavManager.NavigateTo("/profile/payments");
    }
}