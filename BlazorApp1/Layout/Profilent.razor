@page "/profile"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<div class="simple-container">
    <h3>Редактирование имени</h3>

    @if (isLoading)
    {
        <p>Загрузка...</p>
    }
    else
    {
        <div class="form-group">
            <label>Новое имя:</label>
            <input type="text" @bind="newName" class="form-control" />
        </div>

        <button @onclick="UpdateName" class="btn btn-primary">Сохранить</button>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="@(isError ? "error-message" : "success-message")">
                @message
            </div>
        }
    }
</div>

<style>
    .simple-container {
        max-width: 500px;
        margin: 2rem auto;
        padding: 20px;
        border: 1px solid #ddd;
        border-radius: 8px;
    }

    .form-group {
        margin-bottom: 1rem;
    }

    .form-control {
        width: 100%;
        padding: 8px;
        border: 1px solid #ccc;
        border-radius: 4px;
    }

    .btn-primary {
        background-color: #007bff;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 4px;
        cursor: pointer;
    }

    .success-message {
        color: green;
        margin-top: 1rem;
    }

    .error-message {
        color: red;
        margin-top: 1rem;
    }
</style>

@code {
    private string newName = "";
    private string message = "";
    private bool isError = false;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Получаем текущего пользователя
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                // ClaimTypes.GivenName - это имя (без фамилии)
                newName = user.FindFirst(ClaimTypes.GivenName)?.Value ?? "";
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task UpdateName()
    {
        if (string.IsNullOrWhiteSpace(newName))
        {
            message = "Имя не может быть пустым";
            isError = true;
            return;
        }

        try
        {
            var request = new HttpRequestMessage(HttpMethod.Post, "api/User/update-name")
                {
                    Content = JsonContent.Create(new { FirstName = newName })
                };
            // Добавьте проверку аутентификации
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (!authState.User.Identity.IsAuthenticated)
            {
                message = "Пользователь не аутентифицирован";
                isError = true;
                return;
            }

            // Используем относительный путь
            request.SetBrowserRequestCredentials(BrowserRequestCredentials.Include);

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                message = "Имя успешно обновлено!";
                isError = false;

                // Обновляем состояние аутентификации
                var authProvider = (CustomAuthStateProvider)AuthStateProvider;
                await authProvider.UpdateNameAsync(newName);
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                message = "Ошибка авторизации. Пожалуйста, войдите снова.";
                isError = true;
                NavigationManager.NavigateTo("/login");
            }
            else
            {
                message = $"Ошибка: {response.StatusCode} - {await response.Content.ReadAsStringAsync()}";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            message = $"Ошибка: {ex.Message}";
            isError = true;
        }
    }
}