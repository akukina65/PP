@page "/profile"
@layout MainLayout
@using Microsoft.AspNetCore.Components.Authorization
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject HttpClient Http
@inject NavigationManager NavManager
@using YourProjectNamespace.Models
@implements IDisposable

<link href="css/Profil.css?v=3.0" rel="stylesheet" />


<CascadingAuthenticationState>
    <AuthorizeView>
        <Authorized>
            <div class="profile-container">
                <!-- Заголовок с градиентом -->
                <div class="profile-header bg-gradient">
                    <h1><i class="fas fa-user-cog"></i> Настройки автора</h1>
                    <div class="back-link" @onclick="NavigateToHome">
                        <i class="fas fa-arrow-left"></i> На главную
                    </div>
                </div>

                <!-- Уведомление -->
                @if (showNotification)
                {
                    <div class="notification @(isSuccess ? "success" : "error") animate__animated animate__fadeInDown">
                        <i class="fas @(isSuccess ? "fa-check-circle" : "fa-exclamation-circle")"></i>
                        @notificationMessage
                    </div>
                }

                <!-- Основной контент -->
                <div class="profile-content">
                    <!-- Левая колонка - информация о пользователе -->
                    <div class="user-info-section">
                        <!-- Карточка пользователя с тенью -->
                        <div class="user-card shadow">
                            <div class="user-avatar">
                                @if (!string.IsNullOrEmpty(avatarUrl))
                                {
                                    <img src="/images/avatars/@avatarUrl"
                                         alt="@fullName"
                                         class="avatar-img"
                                         onerror="this.onerror=null;this.src='/images/default-avatar.png';" />
                                }
                                else
                                {
                                    <!-- Используем переменную avatarColor -->
                                    <div class="avatar-placeholder" style="background: @avatarColor">
                                        @GetInitials(fullName)
                                    </div>
                                }
                                <div class="avatar-overlay">
                                    <i class="fas fa-camera"></i>
                                </div>
                            </div>
                            <div class="user-details">
                                <h2>@($"{profileModel.LastName} {profileModel.FirstName} {profileModel.Patronymic}".Trim())</h2>
                                <div class="user-meta">
                                    <div class="meta-item">
                                        <i class="fas fa-city"></i>
                                        <span>Город: <strong>@(profileModel.City ?? "Не указан")</strong></span>
                                    </div>
                                    <div class="meta-item">
                                        <i class="fas fa-info-circle"></i>
                                        <span>О себе: <strong>@(profileModel.Bio ?? "Не указано")</strong></span>
                                    </div>
                                    <div class="meta-item">
                                        <i class="fas fa-envelope"></i>
                                        <span>Электронная почта: <strong>@email</strong></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Настройки автора -->
                        <div class="author-settings card shadow">
                            <h3><i class="fas fa-cog"></i> Настройки автора</h3>
                            <div class="settings-actions">
                                <button class="btn-settings" @onclick="NavigateToCourses">
                                    <i class="fas fa-book"></i> Мои курсы
                                </button>
                                <button class="btn-settings" @onclick="NavigateToMaterials">
                                    <i class="fas fa-file-alt"></i> Учебные материалы
                                </button>
                                <button class="btn-settings" @onclick="NavigateToStats">
                                    <i class="fas fa-chart-bar"></i> Статистика
                                </button>
                                <button class="btn-settings" @onclick="NavigateToPayments">
                                    <i class="fas fa-credit-card"></i> Платежи
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Правая колонка - форма редактирования -->
                    <div class="edit-form-section card shadow">
                        <h3><i class="fas fa-edit"></i> Редактировать профиль</h3>

                        <EditForm Model="@profileModel" OnValidSubmit="@SaveProfile">
                            <ChildContent Context="formContext">
                                <DataAnnotationsValidator />

                                <div class="form-row">
                                    <div class="form-group floating">
                                        <InputText @bind-Value="profileModel.FirstName" class="form-control" placeholder=" " />
                                        <label>Имя</label>
                                        <ValidationMessage For="@(() => profileModel.FirstName)" />
                                    </div>

                                    <div class="form-group floating">
                                        <InputText @bind-Value="profileModel.LastName" class="form-control" placeholder=" " />
                                        <label>Фамилия</label>
                                        <ValidationMessage For="@(() => profileModel.LastName)" />
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group floating">
                                        <InputText @bind-Value="profileModel.Patronymic" class="form-control" placeholder=" " />
                                        <label>Отчество</label>
                                        <ValidationMessage For="@(() => profileModel.Patronymic)" />
                                    </div>
                                </div>
                                <!-- Убрано поле "Курс" -->
                                <div class="form-row">
                                    <div class="form-group floating">
                                        <InputText @bind-Value="profileModel.City" class="form-control" placeholder=" " />
                                        <label>Город</label>
                                    </div>
                                </div>

                                <div class="form-group floating">
                                    <InputText @bind-Value="profileModel.Email" class="form-control" placeholder=" " />
                                    <label>Электронная почта</label>
                                    <ValidationMessage For="@(() => profileModel.Email)" />
                                </div>

                                <div class="form-group">
                                    <label><i class="fas fa-info-circle"></i> О себе</label>
                                    <InputTextArea @bind-Value="profileModel.Bio" class="form-control" rows="4" />
                                </div>

                                <div class="form-actions">
                                    <button type="submit" class="btn-primary">
                                        <i class="fas fa-save"></i> Сохранить изменения
                                    </button>
                                    <button type="button" class="btn-outline" @onclick="CancelEditing">
                                        <i class="fas fa-times"></i> Отмена
                                    </button>
                                </div>
                            </ChildContent>
                        </EditForm>
                    </div>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>
</CascadingAuthenticationState>



@code {
  
    private string fullName = "";
    private string email = "";
    private string avatarUrl = "";
    private string? city = null;
    private string? bio = null;
    private string notificationMessage = "";
    private bool showNotification = false;
    private bool isSuccess = true;
    private string avatarColor = "#3498db";
    private ProfileModel profileModel = new();

    protected override async Task OnInitializedAsync()
    {
        (AuthStateProvider as AuthenticationStateProvider)!.AuthenticationStateChanged += AuthStateChanged;
        await LoadProfileData();
    }

    private async void AuthStateChanged(Task<AuthenticationState> task)
    {
        await LoadProfileData();
        StateHasChanged();
    }

    public void Dispose()
    {
        (AuthStateProvider as AuthenticationStateProvider)!.AuthenticationStateChanged -= AuthStateChanged;
    }

    private async Task LoadProfileData()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            // Загружаем цвет из claims
            avatarColor = user.FindFirst("AvatarColor")?.Value ?? "#3498db";

            profileModel = new ProfileModel
                {
                    FirstName = user.FindFirst(ClaimTypes.GivenName)?.Value ?? "",
                    LastName = user.FindFirst(ClaimTypes.Surname)?.Value ?? "",
                    Patronymic = user.FindFirst("Patronymic")?.Value ?? "",
                    Email = user.FindFirst(ClaimTypes.Email)?.Value ?? "",
                    City = user.FindFirst("city")?.Value ?? "",
                    Bio = user.FindFirst("bio")?.Value ?? "",
                    AvatarUrl = user.FindFirst("AvatarUrl")?.Value ?? ""
                };

            fullName = $"{profileModel.LastName} {profileModel.FirstName} {profileModel.Patronymic}".Trim();
            email = profileModel.Email;
            avatarUrl = profileModel.AvatarUrl;
        }
    }



    private string GetInitials(string fullName)
    {
        if (string.IsNullOrEmpty(fullName)) return "??";

        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "??";

        string first = parts[0][0].ToString();
        string last = parts.Length > 1 ? parts[^1][0].ToString() : "";

        // Добавляем инициал отчества, если есть
        string patronymicInitial = parts.Length > 2 ? parts[1][0].ToString() : "";

        return $"{first}{last}{patronymicInitial}".ToUpper();
    }

    private async Task SaveProfile()
    {
        try
        {
            var response = await Http.PostAsJsonAsync("api/User/update-profile", new
            {
                profileModel.FirstName,
                profileModel.LastName,
                profileModel.Patronymic,
                profileModel.Email,
                profileModel.City,
                profileModel.Bio
            });

            if (response.IsSuccessStatusCode)
            {
                var authProvider = (CustomAuthStateProvider)AuthStateProvider;
                await authProvider.UpdateProfileAsync(
                    profileModel.Email,
                    profileModel.FirstName,
                    profileModel.LastName,
                    profileModel.Patronymic,
                    avatarUrl,
                    profileModel.City,
                    profileModel.Bio
                );

                ShowNotification("Профиль успешно обновлен", true);
            }
            else
            {
                ShowNotification($"Ошибка: {response.StatusCode}", false);
            }
        }
        catch (Exception ex)
        {
            ShowNotification($"Ошибка: {ex.Message}", false);
        }
    }
    // Обновленный класс для десериализации ответа
    private class UpdateResult
    {
        public string message { get; set; }
        public UserData user { get; set; }

        public class UserData
        {
            public string name { get; set; }
            public string surname { get; set; }
            public string patronymic { get; set; } // Добавлено
            public string email { get; set; }
            public string City { get; set; }
            public string Bio { get; set; }
            public string AvatarUrl { get; set; }
        }
    }

    private void ShowNotification(string message, bool success)
    {
        notificationMessage = message;
        isSuccess = success;
        showNotification = true;

        // Автоматическое скрытие через 3 секунды
        Task.Delay(3000).ContinueWith(_ =>
        {
            showNotification = false;
            InvokeAsync(StateHasChanged);
        });
    }

    private void CancelEditing()
    {
        // Восстанавливаем оригинальные значения
        var nameParts = fullName.Split(' ', 2);
        string firstName = nameParts.Length > 0 ? nameParts[0] : "";
        string lastName = nameParts.Length > 1 ? nameParts[1] : "";

        profileModel = new ProfileModel
            {
                FirstName = firstName,
                LastName = lastName,
                City = city,
                Email = email,
                Bio = bio
            };
    }

    private void NavigateToHome()
    {
        NavManager.NavigateTo("/glav");
    }

    private void NavigateToCourses()
    {
        NavManager.NavigateTo("/my-courses");
    }

    private void NavigateToMaterials()
    {
        NavManager.NavigateTo("/profile/materials");
    }

    private void NavigateToStats()
    {
        NavManager.NavigateTo("/profile/stats");
    }

    private void NavigateToPayments()
    {
        NavManager.NavigateTo("/profile/payments");
    }
}