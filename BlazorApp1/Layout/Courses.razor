@page "/my-courses"
@layout MainLayout
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject HttpClient Http
@inject NavigationManager NavManager

<link href="css/courses.css" rel="stylesheet" />
<CascadingAuthenticationState>
    <AuthorizeView>
        <Authorized>
            <div class="courses-container">
                @if (errorMessage != null)
                {
                    <div class="error-message">
                        <i class="fas fa-exclamation-circle"></i> @errorMessage
                    </div>
                }

                <div class="courses-header">
                    <!-- Кнопка "На главную" слева -->
                    <button class="btn-home" @onclick="NavigateToHome">
                        <i class="fas fa-home"></i> На главную
                    </button>

                    <h1><i class="fas fa-book"></i> Мои курсы</h1>

                    @if (isAdmin)
                    {
                        <span class="badge badge-admin">Режим администратора</span>
                    }
                    else if (isTeacher)
                    {
                        <span class="badge badge-teacher">Режим преподавателя</span>
                    }
                </div>

                @if (isLoading)
                {
                    <div class="loading">
                        <i class="fas fa-spinner fa-spin"></i> Загрузка курсов...
                    </div>
                }
                else if (courses == null || !courses.Any())
                {
                    <div class="no-courses">
                        <img src="/images/empty-courses.png" alt="Нет курсов" />
                        <h3>@(isStudent ? "У вас пока нет купленных курсов" : "У вас пока нет созданных курсов")</h3>
                        <p>@(isStudent ? "Посетите каталог курсов, чтобы выбрать интересующие вас курсы" : "Создайте новый курс")</p>
                        <button class="btn btn-primary" @onclick="NavigateToCatalog">
                            @(isStudent ? "Перейти в каталог" : "Создать курс")
                        </button>
                    </div>
                }
                else
                {
                    <div class="courses-grid">
                        @foreach (var course in courses)
                        {
                            <div class="course-card">
                                <div class="course-image">
                                    <div class="image-overlay"></div>
                                    <img src="@course.ImageUrl" alt="@course.Title" />
                                    <div class="course-badge">
                                        <i class="fas @(isAdmin ? "fa-shield-alt" : isTeacher ? "fa-chalkboard-teacher" : "fa-graduation-cap")"></i>
                                    </div>
                                </div>
                                <div class="course-info">
                                    <h3>@course.Title</h3>
                                    <p>@course.Description</p>
                                    <div class="course-meta">
                                        <span><i class="fas fa-clock"></i> @course.Duration недель</span>
                                        <span><i class="fas fa-user"></i> @course.StudentsCount студентов</span>
                                        @if (isAdmin || isTeacher)
                                        {
                                            <span><i class="fas fa-star"></i> @course.Rating/5</span>
                                        }
                                    </div>
                                </div>
                                <div class="course-actions">
                                    <button class="btn-outline" @onclick="() => OpenCourse(course.Id)">
                                        <i class="fas fa-door-open"></i> Перейти к курсу
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="not-authorized">
                <p>Для просмотра этой страницы необходимо войти в систему</p>
                <button class="btn btn-primary" @onclick="NavigateToLogin">Войти</button>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>

<style>
    /* Стили для кнопки "На главную" как в вашем примере */
    .btn-home {
        display: inline-flex;
        align-items: center;
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        color: #4e73df;
        padding: 0.5rem 1rem;
        border-radius: 0.375rem;
        cursor: pointer;
        transition: all 0.3s ease;
        font-weight: 500;
        margin-right: 1rem; /* Добавлен отступ справа */
        float: left; /* Выравнивание по левому краю */
    }

        .btn-home:hover {
            background-color: #e9ecef;
            transform: translateY(-2px);
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        }

        .btn-home i {
            margin-right: 0.5rem;
        }

    .courses-header {
        display: flex;
        align-items: center;
        margin-bottom: 1.5rem;
        clear: both; /* Очистка float */
    }

        .courses-header h1 {
            margin: 0;
            flex-grow: 1;
        }

    /* Остальные существующие стили */
    .courses-container {
        /* ... */
    }

    .error-message {
        /* ... */
    }

    /* ... и так далее ... */
</style>

@code {
    private List<CourseDto> courses = new();
    private bool isLoading = true;
    private string errorMessage;
    private bool isStudent = true;
    private bool isTeacher = false;
    private bool isAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                isStudent = user.IsInRole("student");
                isTeacher = user.IsInRole("teacher");
                isAdmin = user.IsInRole("admin");

                Console.WriteLine($"Roles - Student: {isStudent}, Teacher: {isTeacher}, Admin: {isAdmin}");

                string endpoint = isAdmin ? "api/Courses/all" :
                                  isTeacher ? "api/Courses/my-teaching" :
                                  "api/Courses/my-purchased";

                Console.WriteLine($"Using endpoint: {endpoint}");

                var request = new HttpRequestMessage(HttpMethod.Get, endpoint);
                request.Headers.Add("X-Requested-With", "XMLHttpRequest");

                var response = await Http.SendAsync(request);

                if (response.IsSuccessStatusCode)
                {
                    courses = await response.Content.ReadFromJsonAsync<List<CourseDto>>();
                    Console.WriteLine($"Received {courses?.Count ?? 0} courses");
                }
                else
                {
                    errorMessage = $"Ошибка: {response.StatusCode}";
                    Console.WriteLine(errorMessage);
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            Console.WriteLine($"Exception: {ex}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void NavigateToLogin()
    {
        NavManager.NavigateTo("/login");
    }

    private void NavigateToHome()
    {
        NavManager.NavigateTo("/");
    }

    private void NavigateToCatalog()
    {
        NavManager.NavigateTo(isStudent ? "/courses" : "/courses/new");
    }

    private void OpenCourse(int courseId)
    {
        NavManager.NavigateTo($"/course/{courseId}");
    }

    public class CourseDto
    {
        public int Id { get; set; }
        public string Title { get; set; }
        public string Description { get; set; }
        public int Duration { get; set; }
        public string ImageUrl { get; set; }
        public int StudentsCount { get; set; }
        public double Rating { get; set; }
        public int TeacherId { get; set; }
        public string TeacherName { get; set; }
    }
}