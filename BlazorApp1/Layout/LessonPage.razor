@page "/course/{courseId:int}"
@layout MainLayout
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider

<div class="course-page">
    <!-- Заголовок курса -->
    <div class="course-header">
        <button class="btn-back" @onclick="NavigateBack">
            <i class="fas fa-arrow-left"></i> Назад к курсам
        </button>
        <h1>@course?.Title</h1>
        <p>@course?.Description</p>
    </div>

    <!-- Статистика -->
    <div class="course-stats">
        <div class="stat-card">
            <h3>Оплачено занятий</h3>
            <p>@paidLessonsCount</p>
        </div>
        <div class="stat-card">
            <h3>Осталось оплаченных</h3>
            <p>@remainingLessonsCount</p>
        </div>
    </div>

    <!-- Список уроков -->
    <div class="modules-container">
        <h2>Уроки</h2>

        @if (isLoadingLessons)
        {
            <div class="loading">
                <i class="fas fa-spinner fa-spin"></i> Загрузка уроков...
            </div>
        }
        else if (!lessons.Any())
        {
            <div class="no-lessons">
                <i class="fas fa-book-open"></i>
                <p>В этом курсе пока нет уроков</p>
                @if (isTeacherOrAdmin)
                {
                    <button class="btn btn-primary" @onclick="AddNewLesson">
                        <i class="fas fa-plus"></i> Добавить урок
                    </button>
                }
            </div>
        }
        else
        {
            <div class="lessons-list">
                @foreach (var (lesson, index) in lessons.Select((l, i) => (l, i)))
                {
                    <div class="lesson-card" @onclick="() => OpenLesson(lesson.Id)">
                        <div class="lesson-index">@(index + 1)</div>
                        <div class="lesson-info">
                            <h3>@lesson.lessonname</h3>
                            <p>@lesson.lessondescription</p>
                        </div>
                        <div class="lesson-meta">
                            <span>@lesson.quantity занятий</span>
                        </div>
                    </div>
                }
            </div>

            @if (isTeacherOrAdmin)
            {
                <div class="add-lesson-btn">
                    <button class="btn btn-primary" @onclick="AddNewLesson">
                        <i class="fas fa-plus"></i> Добавить новый урок
                    </button>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter] public int courseId { get; set; }

    private CourseDto? course;
    private List<LessonDto> lessons = new();
    private int paidLessonsCount = 0;
    private int remainingLessonsCount = 0;
    private bool isLoadingLessons = true;
    private bool isTeacherOrAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserRole();
        await LoadCourseData();
        await LoadLessons();
    }

    private async Task LoadUserRole()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            isTeacherOrAdmin = user.IsInRole("teacher") || user.IsInRole("admin");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при проверке ролей: {ex.Message}");
        }
    }

    private async Task LoadCourseData()
    {
        try
        {
            course = await Http.GetFromJsonAsync<CourseDto>($"api/Courses/{courseId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки курса: {ex.Message}");
        }
    }

    private async Task LoadLessons()
    {
        try
        {
            isLoadingLessons = true;
            var response = await Http.GetAsync($"api/Courses/{courseId}/lessons");

            if (response.IsSuccessStatusCode)
            {
                lessons = await response.Content.ReadFromJsonAsync<List<LessonDto>>();
                paidLessonsCount = lessons.Sum(l => l.quantity);
                remainingLessonsCount = paidLessonsCount;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки уроков: {ex.Message}");
        }
        finally
        {
            isLoadingLessons = false;
        }
    }

    private void NavigateBack() => NavManager.NavigateTo("/my-courses");
    private void OpenLesson(int lessonId) => NavManager.NavigateTo($"/course/{courseId}/lesson/{lessonId}");
    private void AddNewLesson() => NavManager.NavigateTo($"/course/{courseId}/lesson/new");

    public class CourseDto
    {
        public string? Title { get; set; }
        public string? Description { get; set; }
    }

    public class LessonDto
    {
        public int Id { get; set; }
        public string? lessonname { get; set; }
        public string? lessondescription { get; set; }
        public int quantity { get; set; }
    }
}


<style>
    .course-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #333;
    }

    .course-header {
        position: relative;
        padding-bottom: 1.5rem;
        margin-bottom: 2rem;
        border-bottom: 1px solid #eaeaea;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        color: #4e73df;
        padding: 0.5rem 1rem;
        border-radius: 0.375rem;
        cursor: pointer;
        transition: all 0.3s ease;
        font-weight: 500;
        margin-bottom: 1.5rem;
    }

        .btn-back:hover {
            background-color: #e9ecef;
            transform: translateY(-2px);
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        }

        .btn-back i {
            margin-right: 0.5rem;
        }

    .course-header h1 {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        color: #2e4a8d;
    }

    .course-header p {
        font-size: 1.1rem;
        color: #6c757d;
        max-width: 800px;
        line-height: 1.6;
    }

    .course-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        margin-bottom: 3rem;
    }

    .stat-card {
        background: white;
        border-radius: 0.75rem;
        padding: 1.5rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        text-align: center;
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 25px rgba(0, 0, 0, 0.1);
        }

        .stat-card h3 {
            font-size: 1.1rem;
            margin-bottom: 0.5rem;
            color: #6c757d;
            font-weight: 500;
        }

        .stat-card p {
            font-size: 2rem;
            font-weight: 700;
            margin: 0;
            color: #333;
        }

    .modules-container {
        background: white;
        border-radius: 0.75rem;
        padding: 2rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    }

        .modules-container h2 {
            margin-top: 0;
            margin-bottom: 1.5rem;
            font-size: 1.75rem;
            color: #2e4a8d;
        }

    .loading, .no-lessons {
        text-align: center;
        padding: 3rem 2rem;
        color: #6c757d;
    }

        .loading i {
            font-size: 2rem;
            margin-bottom: 1rem;
            color: #4e73df;
        }

        .no-lessons i {
            font-size: 3rem;
            margin-bottom: 1rem;
            color: #dee2e6;
        }

        .no-lessons p {
            margin-bottom: 1.5rem;
            color: #6c757d;
        }

    .lessons-list {
        display: grid;
        gap: 1.25rem;
    }

    .lesson-card {
        display: flex;
        border: 1px solid #eaeaea;
        border-radius: 0.75rem;
        padding: 1.5rem;
        cursor: pointer;
        transition: all 0.3s ease;
        background: white;
        align-items: center;
        position: relative;
    }

        .lesson-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
            border-color: #4e73df;
        }

    .lesson-index {
        width: 40px;
        height: 40px;
        background: #4e73df;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 1.25rem;
        flex-shrink: 0;
        color: white;
        font-weight: bold;
        font-size: 1.2rem;
    }

    .lesson-info {
        flex-grow: 1;
        min-width: 0;
    }

        .lesson-info h3 {
            font-size: 1.3rem;
            margin: 0 0 0.5rem 0;
            color: #2e4a8d;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .lesson-info p {
            margin: 0;
            color: #6c757d;
            font-size: 0.95rem;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

    .lesson-meta {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        min-width: 120px;
        margin-left: 1rem;
    }

        .lesson-meta span {
            font-size: 0.95rem;
            color: #6c757d;
            font-weight: 500;
        }

    .add-lesson-btn {
        margin-top: 2.5rem;
        text-align: center;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.75rem 1.5rem;
        border-radius: 0.5rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        border: none;
        font-size: 1rem;
    }

    .btn-primary {
        background-color: #4e73df;
        color: white;
        box-shadow: 0 4px 6px rgba(78, 115, 223, 0.3);
    }

        .btn-primary:hover {
            background-color: #2e59d9;
            transform: translateY(-2px);
            box-shadow: 0 6px 8px rgba(78, 115, 223, 0.4);
        }

        .btn-primary i {
            margin-right: 0.5rem;
        }

    /* Анимации */
    .lesson-card {
        animation: fadeIn 0.4s ease forwards;
        opacity: 0;
    }

        .lesson-card:nth-child(1) {
            animation-delay: 0.1s;
        }

        .lesson-card:nth-child(2) {
            animation-delay: 0.2s;
        }

        .lesson-card:nth-child(3) {
            animation-delay: 0.3s;
        }

        .lesson-card:nth-child(4) {
            animation-delay: 0.4s;
        }

        .lesson-card:nth-child(5) {
            animation-delay: 0.5s;
        }

    /* Адаптивность */
    @@media (max-width: 768px) {
        .course-page {
            padding: 1rem;
        }

        .course-header h1 {
            font-size: 2rem;
        }

        .lesson-card {
            flex-direction: column;
            align-items: flex-start;
        }

        .lesson-meta {
            align-items: flex-start;
            margin-left: 0;
            margin-top: 1rem;
            width: 100%;
        }

        .lesson-index {
            margin-bottom: 1rem;
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>