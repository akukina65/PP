@page "/course/{courseId:int}"
@layout MainLayout
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
<div class="course-page">
    <!-- Заголовок курса -->
    <div class="course-header">
        <button class="btn-back" @onclick="NavigateBack">
            <i class="fas fa-arrow-left"></i> Назад к курсам
        </button>
        <button class="btn-home" @onclick="NavigateToHome">
            <i class="fas fa-home"></i> На главную
        </button>
        <h1>@course?.Title</h1>
        <p>@course?.Description</p>
    </div>

    <!-- Статистика -->
    <div class="course-stats">
        <div class="stat-card">
            <h3>Оплачено занятий</h3>
            <p>@paidLessonsCount</p>
        </div>
        <div class="stat-card">
            <h3>Осталось оплаченных</h3>
            <p>@remainingLessonsCount</p>
        </div>
    </div>

    <!-- Список уроков -->
    <div class="modules-container">
        <h2>Уроки</h2>

        @if (isLoadingLessons)
        {
            <div class="loading">
                <i class="fas fa-spinner fa-spin"></i> Загрузка уроков...
            </div>
        }
        else if (!lessons.Any())
        {
            <div class="no-lessons">
                <i class="fas fa-book-open"></i>
                <p>В этом курсе пока нет уроков</p>
                @if (isTeacherOrAdmin)
                {
                    <button class="btn btn-primary" @onclick="AddNewLesson">
                        <i class="fas fa-plus"></i> Добавить урок
                    </button>
                }
            </div>
        }
        else
        {
            <div class="lessons-list">
                @foreach (var (lesson, index) in lessons.Select((l, i) => (l, i)))
                {
                    <div class="lesson-card">
                        <div class="lesson-index">@(index + 1)</div>
                        <div class="lesson-info" @onclick="() => OpenLesson(lesson.Id)">
                            <h3>@lesson.lessonname</h3>
                            <p>@lesson.lessondescription</p>
                        </div>
                        <div class="lesson-meta">
                            <span>@lesson.quantity занятий</span>
                            @if (isTeacherOrAdmin)
                            {
                                <div class="lesson-actions">
                                    <button class="btn-icon" @onclick="() => EditLesson(lesson.Id)" title="Редактировать">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn-icon btn-danger" @onclick="() => DeleteLesson(lesson.Id)" title="Удалить">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            @if (isTeacherOrAdmin)
            {
                <div class="add-lesson-btn">
                    <button class="btn btn-primary" @onclick="AddNewLesson">
                        <i class="fas fa-plus"></i> Добавить новый урок
                    </button>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter] public int courseId { get; set; }

    private CourseDto? course;
    private List<LessonDto> lessons = new();
    private int paidLessonsCount = 0;
    private int remainingLessonsCount = 0;
    private bool isLoadingLessons = true;
    private bool isTeacherOrAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserRole();
        await LoadCourseData();
        await LoadLessons();
    }

    private async Task LoadUserRole()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            isTeacherOrAdmin = user.IsInRole("teacher") || user.IsInRole("admin");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при проверке ролей: {ex.Message}");
        }
    }
    private void NavigateToHome()
    {
        NavManager.NavigateTo("/");
    }
    private async Task LoadCourseData()
    {
        try
        {
            course = await Http.GetFromJsonAsync<CourseDto>($"api/Courses/{courseId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки курса: {ex.Message}");
        }
    }

    private async Task LoadLessons()
    {
        try
        {
            isLoadingLessons = true;
            var response = await Http.GetAsync($"api/Courses/{courseId}/lessons");

            if (response.IsSuccessStatusCode)
            {
                lessons = await response.Content.ReadFromJsonAsync<List<LessonDto>>();
                paidLessonsCount = lessons.Sum(l => l.quantity);
                remainingLessonsCount = paidLessonsCount;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки уроков: {ex.Message}");
        }
        finally
        {
            isLoadingLessons = false;
        }
    }

    private async Task DeleteLesson(int lessonId)
    {
        if (!isTeacherOrAdmin) return;

        // Запрос подтверждения
        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm",
            new object[] { "Вы уверены, что хотите удалить этот урок?" });

        if (!confirm) return;

        try
        {
            var response = await Http.DeleteAsync($"api/Lessons/{lessonId}");

            if (response.IsSuccessStatusCode)
            {
                // Обновляем список уроков после удаления
                await LoadLessons();

                // Уведомление об успешном удалении
                await JSRuntime.InvokeVoidAsync("alert",
                    new object[] { "Урок успешно удален" });
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                await JSRuntime.InvokeVoidAsync("alert",
                    new object[] { $"Ошибка при удалении урока: {error}" });
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert",
                new object[] { $"Ошибка: {ex.Message}" });
        }
    }

    private void NavigateBack() => NavManager.NavigateTo("/my-courses");
    private void OpenLesson(int lessonId) => NavManager.NavigateTo($"/course/{courseId}/lesson/{lessonId}");
    private void EditLesson(int lessonId) => NavManager.NavigateTo($"/course/{courseId}/lesson/{lessonId}/edit");
    private void AddNewLesson() => NavManager.NavigateTo($"/course/{courseId}/lesson/new");

    public class CourseDto
    {
        public string? Title { get; set; }
        public string? Description { get; set; }
    }

    public class LessonDto
    {
        public int Id { get; set; }
        public string? lessonname { get; set; }
        public string? lessondescription { get; set; }
        public int quantity { get; set; }
    }
}

