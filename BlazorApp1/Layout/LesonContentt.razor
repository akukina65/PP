@page "/course/{CourseId:int}/lesson/{LessonId:int}"
@page "/course/{CourseId:int}/lesson/new"
@layout MainLayout
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider
@using Markdig
@using System.Net.Http.Headers
@using System.Text.RegularExpressions
@using YourProjectNamespace.Models

<link href="css/LessonContent.css" rel="stylesheet" />

<div class="lesson-page">
    <div class="lesson-header glass-card">
        <button class="btn-back" @onclick="NavigateBack">
            <i class="fas fa-arrow-left"></i> Назад к курсу
        </button>

        @if (isEditMode && isTeacherOrAdmin)
        {
            <input type="text" class="lesson-title-input" @bind="lesson.lessonname"
                   placeholder="Название урока" />
            <textarea class="lesson-desc-input" @bind="lesson.lessondescription"
                      placeholder="Описание урока"></textarea>
        }
        else
        {
            <h1>@lesson?.lessonname</h1>
            <p>@lesson?.lessondescription</p>
        }
    </div>

    <div class="lesson-content-container glass-card">
        @if (isEditMode && isTeacherOrAdmin)
        {
            <!-- Редактор урока (только для учителей и админов) -->
            <div class="lesson-editor">
                <div class="editor-toolbar">
                    <button type="button" class="tool-btn" @onclick="FormatBold"
                            title="Жирный текст (Ctrl+B)">
                        <i class="fas fa-bold"></i> <span>Жирный</span>
                    </button>

                    <button type="button" class="tool-btn" @onclick="FormatItalic"
                            title="Курсив (Ctrl+I)">
                        <i class="fas fa-italic"></i> <span>Курсив</span>
                    </button>

                    <button type="button" class="tool-btn" @onclick="FormatList"
                            title="Маркированный список">
                        <i class="fas fa-list-ul"></i> <span>Список</span>
                    </button>

                    <button type="button" class="tool-btn" @onclick="ShowImageModal"
                            title="Вставить изображение">
                        <i class="fas fa-image"></i> <span>Изображение</span>
                    </button>

                    <button type="button" class="tool-btn" @onclick="ShowVideoModal"
                            title="Вставить видео">
                        <i class="fas fa-video"></i> <span>Видео</span>
                    </button>

                    <button type="button" class="tool-btn" @onclick="FormatLink"
                            title="Добавить ссылку">
                        <i class="fas fa-link"></i> <span>Ссылка</span>
                    </button>

                    <button type="button" class="tool-btn" @onclick="FormatCode"
                            title="Блок кода">
                        <i class="fas fa-code"></i> <span>Код</span>
                    </button>
                </div>

                <textarea class="editor-content" @bind="lesson.lessoncontent"
                          rows="15" placeholder="Содержимое урока..." @ref="editorTextArea"></textarea>

                <div class="form-group">
                    <label>Количество занятий:</label>
                    <input type="number" class="form-control" @bind="lesson.quantity" min="1" />
                </div>
            </div>

            <!-- Модальные окна для медиа -->
            @if (showImageModal)
            {
                <div class="modal-backdrop show"></div>
                <div class="modal show" style="display:block">
                    <div class="modal-dialog">
                        <div class="modal-content glass-card">
                            <div class="modal-header">
                                <h5 class="modal-title">Вставить изображение</h5>
                                <button type="button" class="btn-close" @onclick="CloseImageModal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="mb-3">
                                    <label class="form-label">Загрузить изображение</label>
                                    <InputFile class="form-control" OnChange="HandleImageUpload"
                                               accept=".jpg,.jpeg,.png,.gif,.webp" />
                                    @if (isUploadingImage)
                                    {
                                        <div class="progress mt-2">
                                            <div class="progress-bar" role="progressbar"
                                                 style="width: @uploadProgress%;">
                                                @uploadProgress%
                                            </div>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(uploadedImageUrl))
                                    {
                                        <div class="mt-2">
                                            <img src="@uploadedImageUrl" class="img-thumbnail"
                                                 style="max-height: 150px;" />
                                        </div>
                                    }
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Или вставить ссылку</label>
                                    <input type="text" class="form-control" @bind="imageUrl"
                                           placeholder="https://example.com/image.jpg" />
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn-secondary" @onclick="CloseImageModal">Отмена</button>
                                <button type="button" class="btn-primary" @onclick="InsertImage"
                                        disabled="@(string.IsNullOrEmpty(uploadedImageUrl) && string.IsNullOrEmpty(imageUrl))">
                                    Вставить
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (showVideoModal)
            {
                <div class="modal-backdrop show"></div>
                <div class="modal show" style="display:block">
                    <div class="modal-dialog">
                        <div class="modal-content glass-card">
                            <div class="modal-header">
                                <h5 class="modal-title">Вставить видео</h5>
                                <button type="button" class="btn-close" @onclick="CloseVideoModal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="mb-3">
                                    <label class="form-label">Загрузить видео (макс. 50MB)</label>
                                    <InputFile class="form-control" OnChange="HandleVideoUpload"
                                               accept=".mp4,.mov,.avi,.mkv,.webm" />
                                    @if (isUploadingVideo)
                                    {
                                        <div class="progress mt-2">
                                            <div class="progress-bar" role="progressbar"
                                                 style="width: @uploadProgress%;">
                                                @uploadProgress%
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Или вставить ссылку (YouTube, Vimeo)</label>
                                    <input type="text" class="form-control" @bind="videoUrl"
                                           placeholder="https://youtube.com/watch?v=..." />
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn-secondary" @onclick="CloseVideoModal">Отмена</button>
                                <button type="button" class="btn-primary" @onclick="InsertVideo"
                                        disabled="@(string.IsNullOrEmpty(uploadedVideoUrl) && string.IsNullOrEmpty(videoUrl))">
                                    Вставить
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="editor-actions">
                <button class="btn-primary" @onclick="SaveLesson">
                    <i class="fas fa-save"></i> Сохранить урок
                </button>
                <button class="btn-secondary" @onclick="CancelEdit">
                    Отмена
                </button>
            </div>
        }
        else
        {
            <!-- Режим просмотра для всех пользователей -->
            <div class="lesson-content">
                @if (lesson == null)
                {
                    <div class="loading">
                        <i class="fas fa-spinner fa-spin"></i> Загрузка урока...
                    </div>
                }
                else
                {
                    @((MarkupString)RenderMarkdown(lesson.lessoncontent))
                }
            </div>

            <!-- Кнопка редактирования только для учителей и админов -->
            @if (isTeacherOrAdmin)
            {
                <div class="lesson-actions">
                    <button class="btn-outline" @onclick="EditLesson">
                        <i class="fas fa-edit"></i> Редактировать
                    </button>
                </div>
            }
        }
    </div>
</div>

<script suppress-error="BL9992">
    function formatText(textarea, before, after) {
        const start = textarea.selectionStart;
        const end = textarea.selectionEnd;
        const selectedText = textarea.value.substring(start, end);

        // Форматируем выделенный текст
        const newText = before + selectedText + after;

        // Обновляем содержимое textarea
        textarea.value = textarea.value.substring(0, start) +
                         newText +
                         textarea.value.substring(end);

        // Устанавливаем позицию курсора
        const newCursorPos = start + before.length;
        textarea.setSelectionRange(newCursorPos, newCursorPos + selectedText.length);
        textarea.focus();

        return textarea.value;
    }
</script>

@code {
    [Parameter] public int CourseId { get; set; }
    [Parameter] public int LessonId { get; set; }

    private bool isTeacherOrAdmin = false;
    private SuperLesson lesson = new SuperLesson();
    private bool isEditMode = false;
    private bool isNewLesson => LessonId == 0;
    private ElementReference editorTextArea;

    // Для загрузки изображений
    private string imageUrl = "";
    private string uploadedImageUrl = "";
    private bool showImageModal = false;
    private bool isUploadingImage = false;

    // Для загрузки видео
    private string videoUrl = "";
    private string uploadedVideoUrl = "";
    private bool showVideoModal = false;
    private bool isUploadingVideo = false;

    // Прогресс загрузки
    private int uploadProgress = 0;

    private Task FormatBold() => FormatText("**", "**");
    private Task FormatItalic() => FormatText("*", "*");
    private Task FormatList() => FormatText("\n- ", "");
    private Task FormatLink() => FormatText("[", "](url)");
    private Task FormatCode() => FormatText("```\n", "\n```");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            // Проверяем роли пользователя (с учетом возможного регистра)
            isTeacherOrAdmin = user.IsInRole("Teacher") ||
                             user.IsInRole("teacher") ||
                             user.IsInRole("Admin") ||
                             user.IsInRole("admin");

            if (isNewLesson)
            {
                if (!isTeacherOrAdmin)
                {
                    await JSRuntime.InvokeVoidAsync("alert", "У вас нет прав для создания уроков");
                    NavManager.NavigateTo($"/course/{CourseId}");
                    return;
                }

                lesson = new SuperLesson
                    {
                        id_courses = CourseId,
                        quantity = 1,
                        lessoncontent = "# Новый урок\n\nНачните писать здесь..."
                    };
                isEditMode = true;
            }
            else
            {
                await LoadLesson();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in OnInitializedAsync: {ex}");
            await JSRuntime.InvokeVoidAsync("alert", $"Ошибка инициализации: {ex.Message}");
        }
    }
    private string ExtractUrlFromJson(string json)
    {
        try
        {
            // Простая обработка JSON без использования System.Text.Json
            var match = Regex.Match(json, "\"url\"\\s*:\\s*\"([^\"]+)\"");
            return match.Success ? match.Groups[1].Value : json;
        }
        catch
        {
            return json;
        }
    }
    private async Task LoadLesson()
    {
        try
        {
            var response = await Http.GetAsync($"api/Lessons/{LessonId}");
            if (!response.IsSuccessStatusCode)
            {
                throw new Exception("Урок не найден");
            }
            lesson = await response.Content.ReadFromJsonAsync<SuperLesson>();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Ошибка загрузки: {ex.Message}");
            NavManager.NavigateTo($"/course/{CourseId}");
        }
    }

    private void NavigateBack()
    {
        NavManager.NavigateTo($"/course/{CourseId}");
    }

    private void EditLesson()
    {
        if (!isTeacherOrAdmin)
        {
            JSRuntime.InvokeVoidAsync("alert", "У вас нет прав для редактирования уроков");
            return;
        }
        isEditMode = true;
    }

    private void CancelEdit()
    {
        if (isNewLesson)
        {
            NavManager.NavigateTo($"/course/{CourseId}");
        }
        else
        {
            isEditMode = false;
        }
    }

    private async Task SaveLesson()
    {
        try
        {
            // Дополнительная проверка прав перед сохранением
            if (!isTeacherOrAdmin)
            {
                await JSRuntime.InvokeVoidAsync("alert", "У вас нет прав для сохранения уроков");
                return;
            }

            HttpResponseMessage response;
            if (isNewLesson)
            {
                response = await Http.PostAsJsonAsync("api/Lessons", lesson);
            }
            else
            {
                response = await Http.PutAsJsonAsync($"api/Lessons/{LessonId}", lesson);
            }

            if (!response.IsSuccessStatusCode)
            {
                throw new Exception(await response.Content.ReadAsStringAsync());
            }

            if (isNewLesson)
            {
                var createdLesson = await response.Content.ReadFromJsonAsync<SuperLesson>();
                NavManager.NavigateTo($"/course/{CourseId}/lesson/{createdLesson.Id}");
            }
            else
            {
                NavManager.NavigateTo($"/course/{CourseId}");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Ошибка сохранения: {ex.Message}");
        }
    }

    // Форматирование текста
    private async Task FormatText(string before, string after)
    {
        lesson.lessoncontent = await JSRuntime.InvokeAsync<string>(
            "formatText",
            editorTextArea,
            before,
            after
        );
    }

    // Модальные окна для медиа
    private void ShowImageModal()
    {
        showImageModal = true;
        imageUrl = "";
        uploadedImageUrl = "";
    }

    private void CloseImageModal()
    {
        showImageModal = false;
        isUploadingImage = false;
    }

    private void ShowVideoModal()
    {
        showVideoModal = true;
        videoUrl = "";
        uploadedVideoUrl = "";
    }

    private void CloseVideoModal()
    {
        showVideoModal = false;
        isUploadingVideo = false;
    }

    // Вставка изображения
    private async Task InsertImage()
    {
        var url = !string.IsNullOrEmpty(uploadedImageUrl) ? uploadedImageUrl : imageUrl;
        if (!string.IsNullOrEmpty(url))
        {
            await FormatText($"![Изображение]({url})", "");
        }
        CloseImageModal();
    }

    // Вставка видео
    private async Task InsertVideo()
    {
        var url = !string.IsNullOrEmpty(uploadedVideoUrl) ? uploadedVideoUrl : videoUrl;
        if (!string.IsNullOrEmpty(url))
        {
            // Для локальных видео
            if (!url.Contains("youtube.com") && !url.Contains("youtu.be") && !url.Contains("vimeo.com"))
            {
                await FormatText($"<video controls width=\"100%\"><source src=\"{url}\" type=\"video/mp4\"></video>", "");
            }
            else
            {
                var embedCode = GetVideoEmbedCode(url);
                await FormatText(embedCode, "");
            }
        }
        CloseVideoModal();
    }

    private string RenderMarkdown(string markdown)
    {
        if (string.IsNullOrEmpty(markdown)) return "";

        // Обрабатываем JSON-строки перед преобразованием Markdown
        markdown = ProcessJsonUrls(markdown);

        var pipeline = new MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .Build();

        var html = Markdown.ToHtml(markdown, pipeline);

        // Дополнительная обработка HTML для видео
        html = ProcessVideoHtml(html);

        return html;
    }
    private string ProcessVideoHtml(string html)
    {
        // Обработка видео-тегов
        html = Regex.Replace(html,
            @"<video\b[^>]*>(.*?)</video>",
            match =>
            {
                var videoTag = match.Value;
                // Удаляем возможные дублирующиеся кавы
                videoTag = videoTag.Replace("\"\"", "\"");
                return $@"<div class=""video-container"">{videoTag}</div>";
            },
            RegexOptions.IgnoreCase | RegexOptions.Singleline);

        return html;
    }
    private string ProcessJsonUrls(string content)
    {
        // Обрабатываем изображения в формате {"url":"..."}
        content = Regex.Replace(content,
            @"!\[(.*?)\]\(\{\""url\"":\""(.*?)\""\}\)",
            "![$1]($2)");

        // Обрабатываем видео в формате {"url":"..."}
        content = Regex.Replace(content,
            @"src=\""\{\""url\"":\""(.*?)\""\}\""",
            "src=\"$1\"");

        return content;
    }
    private string ProcessVideoLinks(string html)
    {
        // Обработка YouTube
        html = Regex.Replace(html,
            @"https?:\/\/(?:www\.)?youtu(?:be\.com\/watch\?v=|\.be\/)([\w\-]+)",
            match =>
            {
                var videoId = match.Groups[1].Value;
                return $@"<div class=""video-container"">
                <iframe src=""https://www.youtube.com/embed/{videoId}""
                frameborder=""0"" allowfullscreen></iframe>
                </div>";
            },
            RegexOptions.IgnoreCase);

        // Обработка Vimeo
        html = Regex.Replace(html,
            @"https?:\/\/vimeo\.com\/(\d+)",
            match =>
            {
                var videoId = match.Groups[1].Value;
                return $@"<div class=""video-container"">
                <iframe src=""https://player.vimeo.com/video/{videoId}""
                frameborder=""0"" allowfullscreen></iframe>
                </div>";
            },
            RegexOptions.IgnoreCase);

        // Обработка локальных видео
        html = Regex.Replace(html,
            @"!\[video\]\(([^)]+)\)",
            match =>
            {
                var videoUrl = match.Groups[1].Value;
                return $@"<div class=""video-container"">
                <video controls width=""100%"">
                <source src=""{videoUrl}"" type=""video/mp4"">
                Ваш браузер не поддерживает видео тег
                </video>
                </div>";
            });

        return html;
    }
    private string GetVideoEmbedCode(string url)
    {
        if (url.Contains("youtube.com") || url.Contains("youtu.be"))
        {
            var videoId = GetYouTubeVideoId(url);
            return $"\n<div class=\"video-container\"><iframe src=\"https://www.youtube.com/embed/{videoId}\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen></iframe></div>\n";
        }

        if (url.Contains("vimeo.com"))
        {
            var videoId = url.Split('/').Last();
            return $"\n<div class=\"video-container\"><iframe src=\"https://player.vimeo.com/video/{videoId}\" frameborder=\"0\" allow=\"autoplay; fullscreen\" allowfullscreen></iframe></div>\n";
        }

        return $"\n<div class=\"video-container\"><video controls width=\"100%\"><source src=\"{url}\" type=\"video/mp4\">Ваш браузер не поддерживает видео</video></div>\n";
    }

    private string GetYouTubeVideoId(string url)
    {
        if (url.Contains("youtu.be"))
        {
            return url.Split('/').Last().Split('?')[0];
        }

        var uri = new Uri(url);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        return query["v"] ?? uri.Segments.Last();
    }

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        try
        {
            isUploadingImage = true;
            uploadProgress = 0;

            var content = new MultipartFormDataContent();
            var stream = e.File.OpenReadStream(10_000_000);
            var fileContent = new StreamContent(stream);
            fileContent.Headers.ContentType = new MediaTypeHeaderValue(e.File.ContentType);
            content.Add(fileContent, "file", e.File.Name);

            var response = await Http.PostAsync("api/Upload/image", content);

            if (response.IsSuccessStatusCode)
            {
                uploadedImageUrl = await response.Content.ReadAsStringAsync();
                imageUrl = uploadedImageUrl;
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                await JSRuntime.InvokeVoidAsync("alert", $"Ошибка загрузки: {error}");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Ошибка: {ex.Message}");
        }
        finally
        {
            isUploadingImage = false;
        }
    }

    private async Task HandleVideoUpload(InputFileChangeEventArgs e)
    {
        try
        {
            isUploadingVideo = true;
            uploadProgress = 0;

            var content = new MultipartFormDataContent();
            var stream = e.File.OpenReadStream(50_000_000);
            var fileContent = new StreamContent(stream);
            fileContent.Headers.ContentType = new MediaTypeHeaderValue(e.File.ContentType);
            content.Add(fileContent, "file", e.File.Name);

            var response = await Http.PostAsync("api/Upload/video", content);

            if (response.IsSuccessStatusCode)
            {
                // Получаем чистый URL без JSON-обертки
                var result = await response.Content.ReadAsStringAsync();
                uploadedVideoUrl = ExtractUrlFromJson(result);
                videoUrl = uploadedVideoUrl;
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                await JSRuntime.InvokeVoidAsync("alert", $"Ошибка загрузки: {error}");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Ошибка: {ex.Message}");
        }
        finally
        {
            isUploadingVideo = false;
        }
    }

   
}