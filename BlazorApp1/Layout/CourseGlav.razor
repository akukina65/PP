@page "/courses"
@page "/courses/category/{CategoryId:int}"
@layout MainLayout
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject HttpClient Http
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime
@using System.Security.Claims
@using BlazorApp1.Models
@inject ShoppingCartService ShoppingCart


<link href="css/CourseGlav.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

<CascadingAuthenticationState>
    <AuthorizeView>
        <Authorized>
            <div class="courses-container">
                <div class="courses-header">
                    <h1><i class="fas fa-graduation-cap"></i> Все курсы</h1>
                    <p>Выберите курс для профессионального роста</p>
                </div>

                @if (isLoading)
                {
                    <div class="loading">
                        <i class="fas fa-spinner fa-spin"></i> Загрузка курсов...
                    </div>
                }
                else if (errorMessage != null)
                {
                    <div class="error-message">
                        <i class="fas fa-exclamation-circle"></i> @errorMessage
                    </div>
                }
                else if (courses == null || !courses.Any())
                {
                    <div class="no-courses">
                        <img src="/images/empty-courses.png" alt="Нет курсов" />
                        <h3>Курсы не найдены</h3>
                        <p>Попробуйте обновить страницу позже</p>
                    </div>
                }
                else
                {
                    <div class="courses-grid">
                        @foreach (var course in courses)
                        {
                            <div class="course-card">
                                <div class="course-image">
                                    <div class="image-overlay"></div>
                                    <img src="@GetCourseImage(course.Id)" alt="@course.Title" />
                                    @if (course.IsNew)
                                    {
                                        <div class="course-badge new">NEW</div>
                                    }
                                    @if (course.IsPopular)
                                    {
                                        <div class="course-badge popular">HOT</div>
                                    }
                                    <div class="course-price">
                                        @if (course.DiscountedPrice > 0)
                                        {
                                            <span class="original-price">@course.Price.ToString("N0") ₽</span>
                                            <span class="discounted-price">@course.DiscountedPrice.ToString("N0") ₽</span>
                                        }
                                        else
                                        {
                                            <span>@course.Price.ToString("N0") ₽</span>
                                        }
                                    </div>
                                </div>
                                <div class="course-info">
                                    <div class="course-meta">
                                        <span><i class="fas fa-star"></i> @course.Rating.ToString("0.0")</span>
                                        <span><i class="fas fa-user-graduate"></i> @course.EnrolledCount</span>
                                        <span><i class="fas fa-clock"></i> @course.Duration недель</span>
                                    </div>
                                    <h3>@course.Title</h3>
                                    <p>@course.Description</p>
                                    <div class="course-category">
                                        <i class="fas fa-tag"></i> @course.Category
                                    </div>
                                </div>
                                <div class="course-actions">
                                    <button class="btn-outline" @onclick="() => ViewCourseDetails(course.Id)">
                                        <i class="fas fa-info-circle"></i> Подробнее
                                    </button>
                                    <button class="btn-primary" @onclick="() => AddToCart(course)">
                                        <i class="fas fa-shopping-cart"></i> Купить
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="not-authorized">
                <div class="auth-prompt">
                    <img src="/images/auth-required.png" alt="Требуется авторизация" />
                    <h3>Для просмотра курсов необходимо войти в систему</h3>
                    <p>Зарегистрируйтесь, чтобы получить доступ ко всем возможностям платформы</p>
                    <div class="auth-buttons">
                        <button class="btn btn-outline" @onclick="NavigateToLogin">Войти</button>
                        <button class="btn btn-primary" @onclick="NavigateToRegister">Регистрация</button>
                    </div>
                </div>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>

@code {
    private List<CourseDto> courses = new();
    private bool isLoading = true;
    private string errorMessage;
    [Parameter]
    public int CategoryId { get; set; }
    private static readonly Dictionary<int, string> courseImages = new()
    {
        { 1, "course-design.png" },
        { 2, "course-dev.png" },
        { 3, "course-marketing.png" },
        { 4, "course-business.png" },
        { 5, "course-science.png" },
        { 6, "course-language.png" }
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // В методе OnInitializedAsync добавьте проверку:
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            Console.WriteLine($"User authenticated: {user.Identity.IsAuthenticated}");
            Console.WriteLine($"Roles: {string.Join(", ", user.Claims.Where(c => c.Type == ClaimTypes.Role).Select(c => c.Value))}");
            await LoadCourses();
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка загрузки курсов: {ex.Message}";
            isLoading = false;
        }
    }
    protected override async Task OnParametersSetAsync()
    {
        if (CategoryId > 0)
        {
            await LoadCategoryCourses();
        }
        else
        {
            await LoadCourses();
        }
    }
    private async Task LoadCategoryCourses()
    {
        try
        {
            isLoading = true;
            courses = await Http.GetFromJsonAsync<List<CourseDto>>($"api/Courses/bycategory/{CategoryId}");
            errorMessage = null;
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка загрузки курсов категории: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
    private async Task LoadCourses()
    {
        try
        {
            isLoading = true;
            courses = await Http.GetFromJsonAsync<List<CourseDto>>("api/Courses/all-public");
            errorMessage = null;
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка загрузки курсов: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

   
    private string GetCourseImage(int courseId)
    {
        // Находим курс по ID
        var course = courses.FirstOrDefault(c => c.Id == courseId);

        // Если у курса есть изображение - используем его
        if (course != null && !string.IsNullOrEmpty(course.ImageUrl))
        {
            return course.ImageUrl;
        }

        // Иначе используем изображение по умолчанию
        return "/images/courses/default-course.png";
    }

    private void ViewCourseDetails(int courseId)
    {
        NavManager.NavigateTo($"/course/{courseId}");
    }

    @inject ShoppingCartService ShoppingCart

    private void AddToCart(CourseDto course)
    {
        ShoppingCart.AddToCart(course);
        NavManager.NavigateTo("/cart"); // Просто переходим в корзину
    }
    private void NavigateToLogin()
    {
        NavManager.NavigateTo("/login");
    }

    private void NavigateToRegister()
    {
        NavManager.NavigateTo("/register");
    }

