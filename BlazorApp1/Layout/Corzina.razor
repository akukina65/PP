
@page "/cart"
@layout MainLayout
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject ShoppingCartService ShoppingCart
@inject HttpClient Http
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime
<CascadingAuthenticationState>
<AuthorizeView>
    <Authorized>
        <div class="cart-container">
            <h2><i class="fas fa-shopping-cart"></i> Ваша корзина</h2>

            @if (ShoppingCart.Items.Count == 0)
            {
                <div class="empty-cart">
                    <img src="/images/empty-cart.png" alt="Корзина пуста" />
                    <h3>Ваша корзина пуста</h3>
                    <p>Добавьте курсы из каталога</p>
                    <button class="btn btn-primary" @onclick="NavigateToCourses">
                        Перейти к курсам
                    </button>
                </div>
            }
            else
            {
                <div class="cart-items">
                    @foreach (var item in ShoppingCart.Items)
                    {
                        <div class="cart-item">
                            <div class="item-image">
                                <img src="@item.ImageUrl" alt="@item.Title" />
                            </div>
                            <div class="item-info">
                                <h3>@item.Title</h3>
                                <p>@item.Description</p>
                                <div class="item-meta">
                                    <span><i class="fas fa-clock"></i> @item.Duration недель</span>
                                    <span class="price">@item.DiscountedPrice.ToString("N0") ₽</span>
                                </div>
                            </div>
                                <button class="remove-btn" @onclick="() => RemoveItem(item.Id)" title="Удалить из корзины">
                                    <i class="fas fa-trash"></i>
                                    <span class="remove-text">Удалить</span>
                                </button>
                        </div>
                    }
                </div>

                <div class="cart-summary">
                    <div class="total">
                        <span>Итого:</span>
                        <span class="total-price">@ShoppingCart.Items.Sum(i => i.DiscountedPrice).ToString("N0") ₽</span>
                    </div>
                    <button class="btn btn-primary checkout-btn" @onclick="Checkout">
                        Оформить заказ
                    </button>
                </div>
            }
        </div>

    </Authorized>
    <NotAuthorized>
        <div class="auth-required">
            <h3>Для оформления заказа необходимо войти в систему</h3>
            <button class="btn btn-primary" @onclick="NavigateToLogin">Войти</button>
        </div>


    </NotAuthorized>
</AuthorizeView>
</CascadingAuthenticationState>
@code {
    protected override void OnInitialized()
    {
        ShoppingCart.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        ShoppingCart.OnChange -= StateHasChanged;
    }
    
    
    private void RemoveItem(int courseId)
    {
        ShoppingCart.RemoveFromCart(courseId);
    }

    private async Task Checkout()
    {
        try
        {
            if (!ShoppingCart.Items.Any())
            {
                await JSRuntime.InvokeVoidAsync("alert", "Корзина пуста!");
                return;
            }

            var result = await ShoppingCart.Checkout();
            if (result)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Заказ оформлен!");
                NavManager.NavigateTo("/orders");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Ошибка оформления. Проверьте консоль.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Checkout error: {ex}");
            await JSRuntime.InvokeVoidAsync("alert", $"Ошибка: {ex.Message}");
        }
    }

    private void NavigateToCourses()
    {
        NavManager.NavigateTo("/courses");
    }

    private void NavigateToLogin()
    {
        NavManager.NavigateTo("/login");
    }
}


        <style>
