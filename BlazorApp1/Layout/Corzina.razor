@page "/cart"
@layout MainLayout
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject ShoppingCartService ShoppingCart
@inject HttpClient Http
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime

<CascadingAuthenticationState>
    <AuthorizeView>
        <Authorized>
            <div class="cart-container">
                <!-- Кнопка "На главную" -->
                <button class="home-button" @onclick="NavigateToHome">
                    <i class="fas fa-home"></i> На главную
                </button>

                <div class="cart-header">
                    <h2><i class="fas fa-shopping-cart"></i> Ваша корзина</h2>
                    <div class="cart-count">@ShoppingCart.Items.Count @GetItemsCountText(ShoppingCart.Items.Count)</div>
                </div>

                @if (ShoppingCart.Items.Count == 0)
                {
                    <div class="empty-cart">
                        <img src="/images/empty-cart.png" alt="Корзина пуста" class="empty-cart-img" />
                        <h3>Ваша корзина пуста</h3>
                        <p>Начните обучение - добавьте курсы из каталога</p>
                        <button class="btn btn-primary btn-catalog" @onclick="NavigateToCourses">
                            <i class="fas fa-book-open"></i> Перейти к курсам
                        </button>
                    </div>
                }
                else
                {
                    <div class="cart-items">
                        @foreach (var item in ShoppingCart.Items)
                        {
                            <div class="cart-item card-hover">
                                <div class="item-image">
                                    <img src="@item.ImageUrl" alt="@item.Title" />
                                    <div class="item-badge">
                                        <i class="fas fa-graduation-cap"></i>
                                    </div>
                                </div>
                                <div class="item-info">
                                    <h3>@item.Title</h3>
                                    <p class="item-description">@item.Description</p>
                                    <div class="item-meta">
                                        <span class="duration"><i class="fas fa-clock"></i> @item.Duration недель</span>
                                        <div class="price-container">
                                            @if (item.DiscountedPrice < item.Price)
                                            {
                                                <span class="original-price">@($"{item.Price.ToString("N0")} руб.")</span>
                                            }
                                            <span class="price">@($"{item.DiscountedPrice.ToString("N0")} руб.")</span>
                                        </div>
                                    </div>
                                </div>
                                <button class="remove-btn" @onclick="() => RemoveItem(item.Id)" title="Удалить из корзины">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        }
                    </div>

                    <div class="cart-summary">
                        <div class="summary-card">
                            <div class="summary-row">
                                <span>Товары (@ShoppingCart.Items.Count)</span>
                                <span>@($"{ShoppingCart.Items.Sum(i => i.Price).ToString("N0")} руб.")</span>
                            </div>
                            <div class="summary-row discount">
                                <span>Скидка</span>
                                <span>-@($"{ShoppingCart.Items.Sum(i => i.Price - i.DiscountedPrice).ToString("N0")} руб.")</span>
                            </div>
                            <div class="divider"></div>
                            <div class="summary-row total">
                                <span>Итого</span>
                                <span class="total-price">@($"{ShoppingCart.Items.Sum(i => i.DiscountedPrice).ToString("N0")} руб.")</span>
                            </div>
                        </div>
                        <button class="btn btn-primary checkout-btn" @onclick="Checkout">
                            <i class="fas fa-credit-card"></i> Оформить заказ
                        </button>
                        <div class="secure-payment">
                            <i class="fas fa-lock"></i>
                            <span>Безопасная оплата</span>
                        </div>
                    </div>
                }
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="auth-required">
                <div class="auth-card">
                    <i class="fas fa-lock auth-icon"></i>
                    <h3>Для оформления заказа необходимо войти в систему</h3>
                    <p>Войдите, чтобы увидеть свои курсы и продолжить обучение</p>
                    <button class="btn btn-primary" @onclick="NavigateToLogin">
                        <i class="fas fa-sign-in-alt"></i> Войти
                    </button>
                    <div class="auth-links">
                        <a href="/register">Ещё нет аккаунта? Зарегистрируйтесь</a>
                    </div>
                </div>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>

@code {
    protected override void OnInitialized()
    {
        ShoppingCart.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        ShoppingCart.OnChange -= StateHasChanged;
    }

    private string GetItemsCountText(int count)
    {
        if (count % 10 == 1 && count % 100 != 11) return "товар";
        if (count % 10 >= 2 && count % 10 <= 4 && (count % 100 < 10 || count % 100 >= 20)) return "товара";
        return "товаров";
    }

    private void RemoveItem(int courseId)
    {
        ShoppingCart.RemoveFromCart(courseId);
    }

    private async Task Checkout()
    {
        try
        {
            if (!ShoppingCart.Items.Any())
            {
                await JSRuntime.InvokeVoidAsync("alert", "Корзина пуста!");
                return;
            }

            var result = await ShoppingCart.Checkout();
            if (result)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Заказ оформлен!");
                
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Ошибка оформления. Проверьте консоль.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Checkout error: {ex}");
            await JSRuntime.InvokeVoidAsync("alert", $"Ошибка: {ex.Message}");
        }
    }

    private void NavigateToHome()
    {
        NavManager.NavigateTo("/");
    }

    private void NavigateToCourses()
    {
        NavManager.NavigateTo("/courses");
    }

    private void NavigateToLogin()
    {
        NavManager.NavigateTo("/login");
    }
}

