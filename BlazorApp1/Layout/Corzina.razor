        border: 1px solid #ef9a9a;
        color: #c62828;
        cursor: pointer;
        padding: 8px 12px;
        border-radius: 4px;
        font-size: 14px;
        transition: all 0.3s ease;
        position: absolute;
        right: 15px;
        top: 15px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .remove-btn:hover {
            background: #ef9a9a;
            color: white;
        }

        .remove-btn .remove-text {
            display: inline-block;
        }

        .remove-btn i {
            font-size: 16px;
        }
    .cart-items {
        margin-bottom: 30px;
    }

    .cart-item {
        display: flex;
        padding: 15px;
        border: 1px solid #eee;
        border-radius: 8px;
        margin-bottom: 15px;
        position: relative;
    }

    .item-image {
        width: 120px;
        height: 80px;
        margin-right: 15px;
    }

        .item-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
